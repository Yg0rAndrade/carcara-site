---
// Destaque do gancho econômico mais forte: o Carcará usa a assinatura do Claude
// que a pessoa já tem — sem chave de API, sem custo por token. Antes era só uma
// pill na prova social e uma linha do FAQ; aqui vira um momento próprio.
---

<!-- DESTAQUE: assinatura, não API -->
<section
  style="padding:clamp(20px,3vw,40px) clamp(20px,5vw,56px); max-width:960px; margin:0 auto;"
>
  <div
    style="position:relative; overflow:hidden; background:linear-gradient(180deg,#fbf3e6,#f7ead5); border:1px solid #e7cfa4; border-radius:20px; padding:clamp(28px,5vw,52px); text-align:center; box-shadow:0 16px 40px rgba(160,111,46,0.14);"
  >
    <div
      style="display:inline-flex; align-items:center; gap:8px; font-family:'Press Start 2P',monospace; font-size:9px; color:#b07d2f; letter-spacing:0.06em; margin-bottom:16px;"
    >
      <svg
        width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      >
        <circle cx="8" cy="15" r="4"></circle>
        <path d="M11 13l7-7M16 5l3 3M14 7l2 2"></path>
      </svg>
      SEM&nbsp;API&nbsp;KEY
    </div>
    <h2
      style="font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(28px,4vw,46px); line-height:1.08; margin:0 0 14px; color:#211C15;"
    >
      Usa a <span style="font-style:italic; color:#C5821C;">sua assinatura</span> do
      Claude.
    </h2>
    <p style="font-size:clamp(16px,1.6vw,18px); line-height:1.55; color:#5C5347; max-width:34em; margin:0 auto;">
      Já paga o Claude? Então já pode usar o Carcará. Ele conversa direto com a sua
      assinatura — <strong style="color:#211C15; font-weight:700;">sem chave de API e
      sem custo por token</strong> a cada mensagem. O que você já tem, funcionando na
      sua IDE.
    </p>
  </div>
</section>
