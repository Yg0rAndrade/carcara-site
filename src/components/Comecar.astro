  }
  .st-cta-back {
    display: inline-block;
    margin-top: 22px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #6b3f0a;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(107, 63, 10, 0.35);
    padding-bottom: 2px;
    transition: border-color 0.16s ease;
  }
  .st-cta-back:hover {
    border-color: #6b3f0a;
  }

  /* estado "copiado" nos botões de copiar */
  .st-copy[data-copied] {
    background: #5ba86b !important;
    color: #fff !important;
    box-shadow: 0 4px 0 #3f7d4d, 0 10px 24px rgba(63, 125, 77, 0.3) !important;
  }
  .st-cta-copy.st-copy[data-copied] {
    box-shadow: none !important;
  }

  /* ===== Responsivo ===== */
  @media (max-width: 900px) {
    .st-prob,
    .st-picker,
    .st-steps,
    .st-ways,
    .st-does {
      grid-template-columns: 1fr;
    }
    .st-prob-title {
      font-size: 26px;
    }
  }
  @media (max-width: 520px) {
    .st-cta-box {
      flex-direction: column;
    }
    .st-cta-copy {
      padding: 13px 20px;
      justify-content: center;
    }
  }
</style>

<script>
  // ===== Picker interativo (os "quadradinhos") =====
  // Clicar numa opção marca ela como ativa e atualiza o painel de resultado com
  // a stack e o motivo (lidos do data-* do próprio card, texto já traduzido).
  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((root) => {
    const opts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-opt]'));
    const result = root.querySelector<HTMLElement>('[data-result]');
    const rStack = root.querySelector<HTMLElement>('[data-r-stack]');
    const rReason = root.querySelector<HTMLElement>('[data-r-reason]');
    if (!result || !rStack || !rReason) return;

    let flipTimer = 0;

    function select(opt: HTMLButtonElement) {
      opts.forEach((o) => {
        const on = o === opt;
        o.toggleAttribute('data-active', on);
        o.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      // pequeno "flip": some e volta com o novo texto
      result!.setAttribute('data-flip', '');
      window.clearTimeout(flipTimer);
      flipTimer = window.setTimeout(() => {
        rStack!.textContent = opt.dataset.stack || '';
        rReason!.textContent = opt.dataset.reason || '';
        result!.removeAttribute('data-flip');
      }, 180);
    }

    opts.forEach((o) => o.addEventListener('click', () => select(o)));
  });

  // ===== Copiar comando =====
  document.querySelectorAll<HTMLButtonElement>('.st-copy').forEach((btn) => {
    const txtEl = btn.querySelector<HTMLElement>('.st-copy-txt');
    const label = btn.dataset.label || '';
    const done = btn.dataset.done || 'Copiado!';
    let timer = 0;

    btn.addEventListener('click', async () => {
      const cmd = btn.dataset.copy || '';
      try {
        await navigator.clipboard.writeText(cmd);
      } catch {
        // fallback: seleção via textarea temporário
        const ta = document.createElement('textarea');
        ta.value = cmd;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
        } catch {
          /* ignore */
        }
        document.body.removeChild(ta);
      }
      btn.setAttribute('data-copied', '');
      if (txtEl) txtEl.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.removeAttribute('data-copied');
        if (txtEl) txtEl.textContent = label;
      }, 1600);
    });
  });
</script>
