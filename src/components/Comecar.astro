---
// ============================================================================
// Página "Como começar um projeto" (corpo compartilhado pt/en). As páginas
// src/pages/comecar/index.astro (pt) e src/pages/en/comecar/index.astro (en)
// só renderizam <Comecar lang=.../>.
//
// Divulga a skill `start` (npx start-skill -> /start no Claude Code) e antecipa
// que ela também vai virar botão dentro do Carcará. Mantém o tema creme + brasa
// e o sistema de faixas (.v2band) da Landing. Regra do projeto: sem travessão.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import CarcaraLogo from './CarcaraLogo.astro';
import RevealScript from './RevealScript.astro';
import { type Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const isPt = lang === 'pt';

// Dicionário local (pt fonte, en fallback pra qualquer idioma não-pt). Mantém a
// página autocontida sem inchar o strings.ts dos 18 idiomas. Sem travessão.
const T = {
  pt: {
    meta: {
      title: 'Como começar um projeto no Claude Code · Carcará Code',
      description:
        'Não sabe qual tecnologia usar? A skill start faz até 3 perguntas simples e monta seu projeto pronto, com a stack certa já configurada. Disponível por comando (npx start-skill) e também dentro do Carcará.',
    },
    hero: {
      kicker: 'COMO COMEÇAR UM PROJETO',
      badge: 'skill start',
      titleL1: 'Não sabe por onde',
      titleL2: 'começar?',
      sub: 'No Lovable é um clique. No Claude Code você trava numa tela preta, sem saber qual tecnologia escolher. A skill start resolve isso: você responde a 1 pergunta simples e ela monta o projeto pronto, com a stack certa já configurada.',
      ctaCopy: 'Copiar npx start-skill',
      ctaCopied: 'Copiado!',
      ctaSee: 'Ver como funciona',
      tags: ['disponível por comando', 'também no Carcará', 'grátis e open source'],
    },
    problem: {
      kicker: 'O PROBLEMA',
      hA: 'Um clique de um lado. ',
      hEm: 'Do outro,',
      hB: ' você trava.',
      p: 'A diferença nunca foi o Claude Code ser pior. É que ninguém te diz por onde começar.',
      cards: [
        {
          tag: 'LOVABLE',
          title: 'Um clique',
          body: 'Você descreve, ele começa. Zero decisão técnica na sua frente.',
          tone: 'ok',
        },
        {
          tag: 'CLAUDE CODE, SEM A SKILL',
          title: 'Uma tela preta',
          body: 'Astro? React? Next? Você trava na primeira escolha, e ela é técnica demais.',
          tone: 'bad',
        },
        {
          tag: 'CLAUDE CODE, COM A SKILL',
          title: 'Uma pergunta',
          body: 'Você diz o que quer no português do dia a dia. A skill decide a tecnologia.',
          tone: 'best',
        },
      ],
    },
