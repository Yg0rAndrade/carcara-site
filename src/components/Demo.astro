---
// Vídeo de demonstração — fachada com poster real; o iframe do YouTube só entra
// no clique (mantém a página leve). Fica logo abaixo do carrossel da seção "A IDE".
import { Image } from 'astro:assets';
import heroShot from '../assets/shots/hero.png';

// ID do vídeo de demonstração no YouTube.
const YT_ID = 'TZSSrXYWrYU';
---

<section
  id="demo"
  style="padding:clamp(8px,2vw,20px) clamp(20px,5vw,56px) clamp(36px,5vw,72px); max-width:1120px; margin:0 auto;"
>
  <div style="text-align:center; margin-bottom:26px;">
    <div
      style="font-family:'Press Start 2P',monospace; font-size:9px; color:#b07d2f; letter-spacing:0.06em; margin-bottom:14px;"
    >
      VEJA&nbsp;EM&nbsp;AÇÃO
    </div>
    <h2
      style="font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(28px,4vw,46px); line-height:1.05; margin:0; color:#211C15;"
    >
      O Carcará em <span style="font-style:italic; color:#C5821C;">1 minuto</span>.
    </h2>
  </div>

  <!-- VÍDEO: fachada com poster real; o iframe do YouTube só entra no clique -->
  <div class="cc-demo-wrap">
    <div class="cc-demo" data-yt={YT_ID}>
      <button type="button" class="cc-demo-play" aria-label="Assistir à demonstração do Carcará Code" style="width:100%; height:100%; display:block; padding:0; margin:0; border:0; background:none; cursor:pointer;">
        <Image
          class="cc-demo-poster"
          src={heroShot}
          alt="Carcará Code rodando: rail de projetos à esquerda, chat do Claude Code no meio e o site em preview ao vivo à direita"
          widths={[640, 960, 1280]}
          sizes="(max-width:900px) 100vw, 900px"
          quality={82}
          style="width:100%; height:100%; object-fit:cover; object-position:top center; display:block;"
        />
        <span class="cc-demo-shade" aria-hidden="true"></span>
        <span class="cc-demo-btn" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
        </span>
        <span class="cc-demo-label" aria-hidden="true">Ver o Carcará em ação · 1 min</span>
      </button>
    </div>
  </div>
</section>

<style>
  .cc-demo-wrap {
    max-width: 900px;
    margin: 0 auto;
  }
  .cc-demo {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(33, 28, 21, 0.12);
    box-shadow: 0 22px 55px rgba(110, 80, 30, 0.2);
    background: #17140f;
  }
  .cc-demo-play {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .cc-demo-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .cc-demo-shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 60% at 50% 45%,
      rgba(23, 20, 15, 0.15),
      rgba(23, 20, 15, 0.42)
    );
    transition: background 0.25s ease;
  }
  .cc-demo-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 78px;
    height: 78px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 4px;
    color: #211c15;
    background: #d99748;
    border-radius: 999px;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.35), 0 0 0 8px rgba(217, 151, 72, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cc-demo-label {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #f4ede1;
    background: rgba(23, 20, 15, 0.6);
    padding: 6px 12px;
    border-radius: 999px;
    white-space: nowrap;
    backdrop-filter: blur(4px);
  }
  .cc-demo-play:hover .cc-demo-btn,
  .cc-demo-play:focus-visible .cc-demo-btn {
    transform: translate(-50%, -50%) scale(1.06);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.4), 0 0 0 12px rgba(217, 151, 72, 0.26);
  }
  .cc-demo-play:hover .cc-demo-shade {
    background: radial-gradient(
      60% 60% at 50% 45%,
      rgba(23, 20, 15, 0.08),
      rgba(23, 20, 15, 0.34)
    );
  }
  .cc-demo-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 620px) {
    .cc-demo-label {
      display: none;
    }
  }
</style>

<script>
  // Troca a fachada pelo player do YouTube só quando o usuário clica.
  document.querySelectorAll<HTMLElement>('.cc-demo').forEach((wrap) => {
    if (wrap.dataset.ccDemoInit) return;
    wrap.dataset.ccDemoInit = '1';
    const btn = wrap.querySelector<HTMLButtonElement>('.cc-demo-play');
    btn?.addEventListener('click', () => {
      const id = wrap.dataset.yt;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      frame.title = 'Demonstração do Carcará Code';
      frame.className = 'cc-demo-frame';
      frame.allow =
        'accelerated-media; autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.setAttribute('allowfullscreen', '');
      // Estilo inline: o CSS escopado do Astro NÃO alcança um elemento criado por
      // JS (falta o atributo de hash do escopo), então o iframe ficaria em 300×150
      // no canto. Inline garante que ele preencha a caixa 16/9.
      frame.style.cssText =
        'position:absolute; inset:0; width:100%; height:100%; border:0; display:block;';
      wrap.replaceChildren(frame);
    });
  });
</script>
