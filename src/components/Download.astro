---
import CarcaraLogo from './CarcaraLogo.astro';
import { release, RELEASES_URL } from '../data/release';
---

<!-- DOWNLOAD -->
<section
  id="download"
  style="padding:clamp(48px,6vw,90px) clamp(20px,5vw,56px); max-width:760px; margin:0 auto; text-align:center;"
>
  <div
    style="background:#FBF8F1; border:1px solid #E7E0D2; border-radius:20px; padding:clamp(32px,5vw,56px); box-shadow:0 16px 40px rgba(110,80,30,0.12);"
  >
    <div
      style="font-family:'Press Start 2P',monospace; font-size:9px; color:#b07d2f; letter-spacing:0.06em; margin-bottom:18px;"
    >
      DOWNLOAD
    </div>
    <h2
      style="font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(34px,5vw,58px); line-height:1.0; margin:0 0 14px; color:#211C15;"
    >
      Solte o <span style="font-style:italic; color:#C5821C;">carcará</span>.
    </h2>
    <p style="font-size:clamp(16px,1.6vw,18px); color:#5C5347; max-width:30em; margin:0 auto 30px;">
      Gratuita e de código aberto. Você só precisa do Node.js e do Claude&nbsp;Code
      logado no terminal.
    </p>
    <a
      href={release.downloadUrl}
      data-dl-link
      style="display:inline-flex; align-items:center; gap:12px; font-family:'Hanken Grotesk',sans-serif; font-weight:700; font-size:18px; color:#211C15; background:#D99748; text-decoration:none; padding:18px 34px; border-radius:13px; box-shadow:0 5px 0 #a06f2e, 0 12px 28px rgba(160,111,46,0.32);"
    >
      <CarcaraLogo width={24} height={24} fill="#211C15" />
      Baixar grátis para Windows
    </a>
    <div
      style="margin-top:16px; font-family:'JetBrains Mono',monospace; font-size:12px; color:#8A8073;"
    >
      <span data-dl-filename>{release.fileName}</span> &nbsp;·&nbsp; Windows 10/11
    </div>
    <div
      style="margin-top:8px; font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#b3a78f;"
    >
      <span data-dl-meta>{release.tag} · {release.size} · {release.date}</span>
      &nbsp;·&nbsp;
      <a
        href={RELEASES_URL}
        target="_blank"
        rel="noopener"
        style="color:#b07d2f; text-decoration:none; border-bottom:1px solid rgba(176,125,47,0.4);"
        >ver todas as versões</a
      >
    </div>
  </div>
</section>
