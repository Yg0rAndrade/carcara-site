---
import CarcaraLogo from './CarcaraLogo.astro';
import { release, RELEASES_URL } from '../data/release';

// "Como começar" honesto: a LP promete facilidade, mas o app precisa de Node.js e
// do Claude Code logado. Em vez de esconder isso, mostramos o caminho em 3 passos
// — e já pré-tratamos o aviso do SmartScreen do Windows (passo 02).
const steps = [
  {
    n: '01',
    title: 'Node.js + Claude Code',
    body: 'Instale o Node.js e faça login no Claude Code uma vez. É o motor que o Carcará usa por baixo.',
  },
  {
    n: '02',
    title: 'Baixe e instale',
    body: 'Rode o instalador pra Windows. Na primeira vez o Windows pode dizer que "protegeu seu PC" — clique em Mais informações › Executar assim mesmo (o app ainda não é assinado).',
  },
  {
    n: '03',
    title: 'Aponte sua pasta',
    body: 'Abra o Carcará, escolha a pasta onde ficam seus projetos e solte o bicho. Cada subpasta vira um ícone no rail.',
  },
];
---

<!-- DOWNLOAD -->
<section
  id="download"
  style="padding:clamp(48px,6vw,90px) clamp(20px,5vw,56px); max-width:900px; margin:0 auto; text-align:center;"
>
  <div
    style="font-family:'Press Start 2P',monospace; font-size:9px; color:#b07d2f; letter-spacing:0.06em; margin-bottom:18px;"
  >
    DOWNLOAD
  </div>
  <h2
    style="font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(34px,5vw,58px); line-height:1.0; margin:0 0 14px; color:#211C15;"
  >
    Solte o <span style="font-style:italic; color:#C5821C;">carcará</span>.
  </h2>
  <p style="font-size:clamp(16px,1.6vw,18px); color:#5C5347; max-width:32em; margin:0 auto 36px;">
    Gratuita e de código aberto. Do zero ao primeiro projeto em três passos.
  </p>

  <!-- Como começar em 3 passos -->
  <div class="cc-start-grid">
    {
      steps.map((s) => (
        <div style="text-align:left;">
          <div style="font-family:'Press Start 2P',monospace; font-size:16px; color:#D99748; margin-bottom:12px;">
            {s.n}
          </div>
          <h3 style="font-family:'Hanken Grotesk',sans-serif; font-size:17px; font-weight:800; margin:0 0 6px; color:#211C15;">
            {s.title}
          </h3>
          <p style="font-size:14.5px; line-height:1.55; color:#5C5347; margin:0;">
            {s.body}
          </p>
        </div>
      ))
    }
  </div>

  <!-- Card de CTA -->
  <div
    style="background:#FBF8F1; border:1px solid #E7E0D2; border-radius:20px; padding:clamp(28px,4vw,44px); box-shadow:0 16px 40px rgba(110,80,30,0.12);"
  >
    <a
      href={release.downloadUrl}
      data-dl-link
      style="display:inline-flex; align-items:center; gap:12px; font-family:'Hanken Grotesk',sans-serif; font-weight:700; font-size:18px; color:#211C15; background:#D99748; text-decoration:none; padding:18px 34px; border-radius:13px; box-shadow:0 5px 0 #a06f2e, 0 12px 28px rgba(160,111,46,0.32);"
    >
      <CarcaraLogo width={24} height={24} fill="#211C15" />
      Baixar grátis para Windows
    </a>
    <div
      style="margin-top:16px; font-family:'JetBrains Mono',monospace; font-size:12px; color:#8A8073;"
    >
      <span data-dl-filename>{release.fileName}</span> &nbsp;·&nbsp; Windows 10/11
    </div>
    <div
      style="margin-top:8px; font-family:'JetBrains Mono',monospace; font-size:11.5px; color:#b3a78f;"
    >
      <span data-dl-meta>{release.tag} · {release.size} · {release.date}</span>
      &nbsp;·&nbsp;
      <a
        href={RELEASES_URL}
        target="_blank"
        rel="noopener"
        style="color:#b07d2f; text-decoration:none; border-bottom:1px solid rgba(176,125,47,0.4);"
        >ver todas as versões</a
      >
    </div>
  </div>
</section>

<style>
  .cc-start-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 3vw, 34px);
    max-width: 760px;
    margin: 0 auto clamp(32px, 5vw, 48px);
  }
  @media (max-width: 640px) {
    .cc-start-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
</style>
