---
// Perguntas frequentes, acordeão nativo (<details>/<summary>).
// Respostas baseadas no que o Carcará Code realmente faz. Textos vêm do
// dicionário i18n (pt/en).
import { useStrings, type Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const s = useStrings(lang);
const faqs = s.faq.items;

// Structured data (schema.org FAQPage), deixa cada pergunta/resposta legível pro
// Google e pras buscas por IA, com chance de virar rich result.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />


<!-- FAQ -->
<section
  id="faq"
  style="padding:clamp(48px,6vw,90px) clamp(20px,5vw,56px); max-width:820px; margin:0 auto;"
>
  <div style="text-align:center; margin-bottom:clamp(20px,3vw,36px);">
    <div
      style="font-family:'Press Start 2P',monospace; font-size:9px; color:#b07d2f; letter-spacing:0.06em; margin-bottom:16px;"
    >
      {s.faq.kicker}
    </div>
    <h2
      style="font-family:'Instrument Serif',serif; font-weight:400; font-size:clamp(30px,4vw,46px); line-height:1.06; margin:0; color:#211C15;"
    >
      {s.faq.h.a}<span style="font-style:italic; color:#C5821C;">{s.faq.h.em}</span>{s.faq.h.b}
    </h2>
  </div>

  <div class="cc-faq-list">
    {
      faqs.map((f, i) => (
        <details
          class="cc-faq-item"
          style={`border-top:1px solid #E7E0D2;${
            i === faqs.length - 1 ? ' border-bottom:1px solid #E7E0D2;' : ''
          }`}
        >
          <summary class="cc-faq-q">
            <span
              style="font-family:'Hanken Grotesk',sans-serif; font-size:clamp(16.5px,1.7vw,20px); font-weight:800; color:#211C15;"
            >
              {f.q}
            </span>
            <span class="cc-faq-mark" aria-hidden="true">
              <!-- chevron em pixel art (blocos), no mesmo espírito da fonte Press Start 2P -->
              <svg class="cc-faq-chevron" width="16" height="8" viewBox="0 0 12 6" fill="currentColor" shape-rendering="crispEdges">
                <rect x="0" y="0" width="2" height="2" />
                <rect x="10" y="0" width="2" height="2" />
                <rect x="2" y="2" width="2" height="2" />
                <rect x="8" y="2" width="2" height="2" />
                <rect x="4" y="4" width="2" height="2" />
                <rect x="6" y="4" width="2" height="2" />
              </svg>
            </span>
          </summary>
          <p class="cc-faq-a">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .cc-faq-item {
    overflow: hidden;
  }
  .cc-faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  /* remove o triângulo padrão do <details> */
  .cc-faq-q::-webkit-details-marker {
    display: none;
  }
  .cc-faq-mark {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    color: #d99748;
    background: #fbf1df;
    transition: transform 0.25s ease, background 0.2s ease, color 0.2s ease;
  }
  .cc-faq-item[open] .cc-faq-mark {
    transform: rotate(180deg);
    background: #d99748;
    color: #fff;
  }
  .cc-faq-a {
    margin: -4px 4px 22px;
    max-width: 44em;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: #5c5347;
  }
</style>
