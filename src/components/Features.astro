---
// "Como funciona" — passos numerados.
const steps = [
  {
    n: '01',
    title: 'Um bando de projetos',
    body: 'Cada subpasta da sua pasta raiz vira um ícone no rail. Bateu o olho, achou o projeto, sem abrir cinco janelas.',
  },
  {
    n: '02',
    title: 'A IA na pasta certa',
    body: 'A conversa já aponta pro projeto aberto. Feito sob medida pro Claude Code, e pronto pra trabalhar com outras IAs de código também.',
  },
  {
    n: '03',
    title: 'Seu site ao vivo',
    body: 'A IDE detecta o servidor de desenvolvimento, sobe ele e mostra seu site embutido. Se já estiver rodando, não sobe de novo.',
  },
  {
    n: '04',
    title: 'Vários ao mesmo tempo',
    body: 'Cada projeto guarda sua conversa e seu preview enquanto o app está aberto. Pule de um para outro sem perder o fio.',
  },
  {
    n: '05',
    title: 'Volte no tempo',
    body: 'Não curtiu o que a IA fez? Volte pra qualquer ponto anterior e desfaça num clique. O Carcará guarda checkpoints num repositório-sombra — sem sujar o seu histórico do Git.',
  },
];
---

<!-- FEATURES -->
<section
  id="recursos"
  style="padding:clamp(48px,6vw,90px) clamp(20px,5vw,56px); max-width:980px; margin:0 auto;"
>
  <div style="text-align:center;">
    <div
      style="font-family:'Press Start 2P',monospace; font-size:9px; color:#b07d2f; letter-spacing:0.06em; margin-bottom:14px;"
    >
      COMO&nbsp;FUNCIONA
    </div>
    <p
      style="font-size:clamp(15px,1.5vw,18px); line-height:1.5; color:#5C5347; max-width:36em; margin:0 auto 18px;"
    >
      Pensado pro <strong style="color:#211C15; font-weight:700;">Claude Code</strong>,
      e aberto pra trabalhar com qualquer IA de código. Seus projetos, do seu jeito.
    </p>
  </div>
  <div style="display:flex; flex-direction:column;">
    {
      steps.map((s, i) => (
        <div
          style={`display:grid; grid-template-columns:74px 1fr; gap:20px; align-items:baseline; padding:24px 0; border-top:1px solid #E7E0D2;${
            i === steps.length - 1 ? ' border-bottom:1px solid #E7E0D2;' : ''
          }`}
        >
          <div style="font-family:'Press Start 2P',monospace; font-size:22px; color:#D99748;">
            {s.n}
          </div>
          <div>
            <h3 style="font-family:'Hanken Grotesk',sans-serif; font-size:clamp(19px,2vw,24px); font-weight:800; margin:0 0 6px; color:#211C15;">
              {s.title}
            </h3>
            <p style="font-size:clamp(15px,1.4vw,17px); line-height:1.55; color:#5C5347; margin:0;">
              {s.body}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
