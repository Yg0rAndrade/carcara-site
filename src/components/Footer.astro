---
import CarcaraLogo from './CarcaraLogo.astro';
import { REPO_URL } from '../data/repo';
import { useStrings, type Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const s = useStrings(lang);
const by = lang === 'pt' ? 'por' : 'by';
---

<!-- FOOTER -->
<footer class="cc-footer">
  <div class="cc-footer-inner">
    <div class="cc-footer-brand">
      <CarcaraLogo width={24} height={24} />
      <div class="cc-footer-brand-txt">
        <span class="cc-footer-name">CARCARÁ CODE</span>
        <span class="cc-footer-tag">{s.footer.tag}</span>
      </div>
    </div>
    <nav class="cc-footer-links" aria-label="Footer">
      <a href="#ide">{s.footer.links.ide}</a>
      <a href="#multiplexador">{s.footer.links.mux}</a>
      <a href="#faq">{s.footer.links.faq}</a>
      <a href="#download">{s.footer.links.download}</a>
      <a href={REPO_URL} target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>

  <div class="cc-footer-bottom">
    <span>{s.footer.rights}</span>
    <span class="cc-footer-made">
      {s.footer.made} <span aria-hidden="true">❤️</span> {by}
      <a href="https://ygorandrade.work" target="_blank" rel="noopener">Ygor Andrade</a>
    </span>
  </div>
</footer>

<style>
  .cc-footer {
    border-top: 1px solid rgba(110, 90, 55, 0.22);
    background: rgba(251, 248, 241, 0.55);
    padding: 42px clamp(20px, 5vw, 56px) 28px;
  }
  .cc-footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 22px;
  }
  .cc-footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cc-footer-name {
    display: block;
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    color: #211c15;
    letter-spacing: 0.01em;
  }
  .cc-footer-tag {
    display: block;
    margin-top: 7px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #8a8073;
  }
  .cc-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }
  .cc-footer-links a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: #5c5347;
    text-decoration: none;
    transition: color 0.16s ease;
  }
  .cc-footer-links a:hover {
    color: #c5821c;
  }
  .cc-footer-bottom {
    max-width: 1120px;
    margin: 26px auto 0;
    padding-top: 22px;
    border-top: 1px solid rgba(110, 90, 55, 0.14);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #8a8073;
  }
  .cc-footer-made a {
    color: #b07d2f;
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid rgba(176, 125, 47, 0.45);
  }
  .cc-footer-made a:hover {
    color: #c5821c;
  }
  @media (max-width: 620px) {
    .cc-footer-inner,
    .cc-footer-bottom {
      justify-content: center;
      text-align: center;
    }
    .cc-footer-brand {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
