---
import CarcaraLogo from './CarcaraLogo.astro';
import { REPO_URL } from '../data/repo';
---

<!-- FOOTER -->
<footer
  style="border-top:1px solid rgba(110,90,55,0.18); padding:34px clamp(20px,5vw,56px); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:18px; max-width:1120px; margin:0 auto;"
>
  <div style="display:flex; align-items:center; gap:11px;">
    <CarcaraLogo width={20} height={20} />
    <span style="font-family:'Press Start 2P',monospace; font-size:9px; color:#6A6053;"
      >CARCARÁ CODE</span
    >
  </div>
  <div style="display:flex; gap:22px;">
    <a
      href={REPO_URL}
      target="_blank"
      rel="noopener"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none;"
      >github</a
    >
  </div>
  <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#9b9080;"
    >MIT · não deixa projeto pra trás · 2026</span
  >

  <div
    style="flex-basis:100%; text-align:center; padding-top:20px; margin-top:4px; border-top:1px solid rgba(110,90,55,0.12); font-family:'JetBrains Mono',monospace; font-size:12px; color:#8A8073;"
  >
    feito com <span style="color:#E4641A;">❤️</span> por
    <a
      href="https://ygorandrade.work"
      target="_blank"
      rel="noopener"
      style="color:#b07d2f; text-decoration:none; font-weight:700; border-bottom:1px solid rgba(176,125,47,0.45);"
      >Ygor Andrade</a
    >
  </div>
</footer>
