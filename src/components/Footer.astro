>
  <div style="display:flex; align-items:center; gap:11px;">
    <CarcaraLogo width={20} height={20} />
    <span style="font-family:'Press Start 2P',monospace; font-size:9px; color:#6A6053;"
      >CARCARÁ CODE</span
    >
  </div>
  <div style="display:flex; gap:22px;">
    <a
      href="#"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none;"
      >github</a
    >
    <a
      href="#"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none;"
      >docs</a
    >
    <a
      href="#"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none;"
