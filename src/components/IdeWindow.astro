---
import CarcaraLogo from './CarcaraLogo.astro';
import ProjectIcons from './ProjectIcons.astro';
import { projects } from '../data/projects';

// Janela da IDE recriada em HTML/CSS, no MESMO tema do site (creme + brasa,
// Press Start 2P / Hanken / JetBrains Mono). Reaproveitada no Hero (compacta) e
// na seção "Muitos projetos" (completa, com a fileira de ferramentas). Mostra a
// estrutura real do app: rail de projetos, chat do Claude e o preview com as
// abas Preview/Código/Git + ferramentas (API, MCP, Histórico, Board).
interface Props {
  compact?: boolean;
  showTools?: boolean;
}
const { compact = false, showTools = !compact } = Astro.props;

const railW = compact ? 58 : 64;
const minH = compact ? 360 : 432;
const active = projects[0];

// Ícones de traço (stroke = currentColor) usados nas abas e no rail.
const ICON = {
  search:
    '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  git: '<line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  zap: '<path d="M13 2 4 14h6l-1 8 9-12h-6z"/>',
  plug: '<path d="M9 2v5M15 2v5M7 7h10v3a5 5 0 0 1-10 0z"/><path d="M12 15v5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
  pen: '<path d="M12 19l7-7-3-3-7 7v3z"/><path d="M15.5 8.5l3 3"/>',
};

const tools = [
  { key: 'zap', label: 'API' },
  { key: 'plug', label: 'MCP' },
  { key: 'clock', label: 'Histórico' },
  { key: 'pen', label: 'Board' },
];
---

<div
  style={`border:1px solid #E2DAC9; background:#FBF8F1; border-radius:16px; box-shadow:0 1px 0 rgba(255,255,255,0.7) inset, 0 28px 60px -20px rgba(110,80,30,0.45), 0 10px 22px -12px rgba(110,80,30,0.22); overflow:hidden;`}
>
  <!-- titlebar -->
  <div
    style="display:flex; align-items:center; gap:8px; padding:11px 15px; background:#F3EEE4; border-bottom:1px solid #E7E0D2;"
  >
    <span style="width:11px;height:11px;border-radius:50%;background:#E4641A;"></span>
    <span style="width:11px;height:11px;border-radius:50%;background:#D99748;"></span>
    <span style="width:11px;height:11px;border-radius:50%;background:#5BA86B;"></span>
    <div style="margin-left:9px; display:flex; align-items:center; gap:8px;">
      <CarcaraLogo width={14} height={14} />
      <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#8A8073;"
        >Carcará Code</span
      >
    </div>
  </div>

  <div
    class="cc-ide-grid"
    style={`display:grid; grid-template-columns:${railW}px 1fr ${compact ? '1.05fr' : '1.12fr'}; min-height:${minH}px;`}
  >
    <!-- RAIL -->
    <div
      class="cc-ide-rail"
      style="border-right:1px solid #EAE3D5; background:#F3EEE4; padding:13px 0; display:flex; flex-direction:column; align-items:center; gap:11px;"
    >
      <span
        title="Buscar (Ctrl K)"
        style="display:grid; place-items:center; width:40px; height:40px; border-radius:50%; border:1px solid #E2DAC9; background:#FCFAF5; color:#9b9080;"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.search} />
      </span>
      <span style="width:26px; height:1px; background:#E2DAC9; border-radius:2px;"></span>
      <ProjectIcons />
      <span
        style="width:42px; height:42px; border-radius:12px; border:1.5px dashed #cbbfa8; color:#b3a78f; display:grid; place-items:center; margin-top:1px;"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.plus} />
      </span>
    </div>

    <!-- CHAT -->
    <div
      class="cc-ide-chat"
      style="border-right:1px solid #EAE3D5; display:flex; flex-direction:column; background:#FCFAF5;"
    >
      <div
        style="height:46px; padding:0 15px; border-bottom:1px solid #EAE3D5; display:flex; align-items:center; gap:9px;"
      >
        <span style="width:8px;height:8px;border-radius:50%;background:#5BA86B;"></span>
        <span
          data-active-name
          style="font-family:'Hanken Grotesk',sans-serif; font-weight:700; font-size:14px; color:#211C15;"
          >{active.name}</span
        >
        <span
          style="margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:11px; color:#a89c87;"
          >claude code</span
        >
      </div>
      <div style="padding:15px; display:flex; flex-direction:column; gap:12px; flex:1;">
        <div
          style="align-self:flex-end; max-width:80%; background:#D99748; color:#211C15; padding:10px 13px; border-radius:13px 13px 4px 13px; font-size:13px; line-height:1.45;"
        >
          adiciona um carrinho na home e sobe o preview
        </div>
        <div style="display:flex; gap:9px; align-items:flex-start; max-width:90%;">
          <span
            style="flex:none; width:26px;height:26px;border-radius:8px; background:#F3EEE4; border:1px solid #E7E0D2; display:grid; place-items:center;"
          >
            <CarcaraLogo width={15} height={15} />
          </span>
          <div
            style="background:#F3EEE4; color:#3a342b; padding:10px 13px; border-radius:13px 13px 13px 4px; font-size:13px; line-height:1.5;"
          >
            Feito! Carrinho na home e preview no ar.
            <span
              style="display:inline-flex; align-items:center; gap:6px; margin-top:8px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#8A8073; background:#FCFAF5; border:1px solid #E7E0D2; padding:3px 8px; border-radius:6px;"
              >src/Home.jsx <span style="color:#5BA86B;">+38</span>
              <span style="color:#E4641A;">−4</span></span
            >
          </div>
        </div>
        <div
          style="margin-top:auto; display:flex; align-items:center; gap:8px; border:1px solid #E2DAC9; border-radius:11px; padding:9px 12px; background:#fff;"
        >
          <span style="font-family:'Hanken Grotesk',sans-serif; font-size:13px; color:#a89c87; flex:1;"
            >Peça uma alteração…</span
          >
          <span
            style="display:grid; place-items:center; width:28px;height:28px;border-radius:8px;background:#D99748; color:#211C15; font-size:14px; font-weight:700;"
            >↑</span
          >
        </div>
      </div>
    </div>

    <!-- PREVIEW (com barra de abas) -->
    <div style="display:flex; flex-direction:column; background:#fff; min-width:0;">
      <!-- tab bar -->
      <div
        style="height:46px; padding:0 11px; border-bottom:1px solid #EAE3D5; background:#FCFAF5; display:flex; align-items:center; gap:9px;"
      >
        <div
          style="display:inline-flex; align-items:center; gap:3px; padding:3px; border-radius:10px; background:#F3EEE4;"
        >
          <span
            style="display:inline-flex; align-items:center; gap:6px; height:26px; padding:0 10px; border-radius:7px; background:#fff; box-shadow:0 1px 2px rgba(110,80,30,0.12); font-family:'Hanken Grotesk',sans-serif; font-size:12.5px; font-weight:700; color:#C5821C;"
            ><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.globe} />Preview</span
          >
          <span
            style="display:inline-flex; align-items:center; gap:6px; height:26px; padding:0 10px; font-family:'Hanken Grotesk',sans-serif; font-size:12.5px; font-weight:600; color:#8A8073;"
            ><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.code} />Código</span
          >
          <span
            style="display:inline-flex; align-items:center; gap:6px; height:26px; padding:0 10px; font-family:'Hanken Grotesk',sans-serif; font-size:12.5px; font-weight:600; color:#8A8073;"
            ><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.git} />Git</span
          >
        </div>

        {showTools && (
          <>
            <span style="width:1px; height:20px; background:#E7E0D2;"></span>
            <div style="display:inline-flex; align-items:center; gap:2px;">
              {tools.map((tool) => (
                <span
                  title={tool.label}
                  style="display:grid; place-items:center; width:28px; height:28px; border-radius:7px; color:#a89c87;"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON[tool.key]} />
                </span>
              ))}
            </div>
          </>
        )}

        <span
          style="margin-left:auto; display:inline-flex; align-items:center; gap:6px; font-family:'JetBrains Mono',monospace; font-size:11px; color:#8A8073; background:#F3EEE4; border:1px solid #E7E0D2; padding:4px 9px; border-radius:7px;"
          ><span style="width:6px;height:6px;border-radius:50%;background:#5BA86B; animation:ccpulse 2s ease-in-out infinite;"></span>localhost:5173</span
        >
      </div>

      <!-- rendered site -->
      <div style="flex:1; padding:17px; display:flex; flex-direction:column; gap:12px;">
        <div style="display:flex; align-items:center; gap:9px;">
          <span data-active-color style={`width:24px;height:24px;border-radius:7px; background:${active.color};`}></span>
          <span style="height:9px; width:90px; border-radius:4px; background:#ECE5D7;"></span>
          <span style="margin-left:auto; height:8px; width:54px; border-radius:4px; background:#F0EAdd;"></span>
        </div>
        <div
          style="flex:1; border-radius:10px; background:#F7F2E9; border:1px solid #EFE8DA; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:11px; padding:18px; text-align:center;"
        >
          <div style="height:15px; width:68%; border-radius:5px; background:#E4DCCB;"></div>
          <div style="height:9px; width:84%; border-radius:4px; background:#ECE5D7;"></div>
          <div style="height:9px; width:74%; border-radius:4px; background:#ECE5D7;"></div>
          <div
            data-active-color
            style={`margin-top:6px; height:30px; width:128px; border-radius:8px; background:${active.color};`}
          ></div>
        </div>
      </div>
    </div>
  </div>
</div>
