---
// ============================================================================
// Landing principal (corpo compartilhado pt/en). As páginas src/pages/index.astro
// (pt, raiz) e src/pages/en/index.astro (en) só renderizam <Landing lang=.../>.
// Todo o texto vem do dicionário i18n (src/i18n/strings.ts). Mantém o tema
// creme + brasa. Regra do projeto: sem travessão (—) em nenhum texto.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import IdeWindow from './IdeWindow.astro';
import Seletor from './Seletor.astro';
import Demo from './Demo.astro';
import Faq from './Faq.astro';
import CarcaraLogo from './CarcaraLogo.astro';
import ProjectRailScript from './ProjectRailScript.astro';
import RefreshReleaseScript from './RefreshReleaseScript.astro';
import { Image } from 'astro:assets';
import { release, LATEST_RELEASE_URL } from '../data/release';
import { REPO_URL } from '../data/repo';
import { projects, letterOf, tx } from '../data/projects';
import { useStrings, type Lang } from '../i18n/strings';

import aiPerProject from '../assets/shots/ai-per-project.png';
import codeShot from '../assets/shots/code.png';
import previewSite from '../assets/shots/preview-site.png';
import previewLogin from '../assets/shots/preview-login.png';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const s = useStrings(lang);

// Ícones de traço (stroke = currentColor), mesmo estilo do resto do site.
const ICON: Record<string, string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
};

// Screenshots reais, um recurso por slide (imagens fixas, textos do dicionário).
const slideImgs = [aiPerProject, codeShot, previewSite, previewLogin];
const slides = s.slides.map((t, i) => ({ ...t, img: slideImgs[i] }));

// Tabela comparativa: o jeito difícil vs. com o Carcará.
const compare = s.compare.rows;
---

<Layout lang={lang}>
  <Nav lang={lang} />

  <!-- ===================== HERO (faixa creme) ===================== -->
  <section class="v2band v2-hero">
    <div class="v2wrap v2-hero-grid">
      <div>
        <div class="v2-badge">
          <CarcaraLogo width={14} height={14} />
          <span class="v2-badge-static" set:html={s.hero.badgeStatic.replace(/ /g, '&nbsp;')} />
          <span class="v2-badge-rotator" aria-live="polite"><span class="v2-badge-type">CLAUDE&nbsp;CODE</span><span class="v2-badge-caret" aria-hidden="true"></span></span>
        </div>
        <h1 class="v2-hero-title">
          <span class="v2-hero-l1">{s.hero.titleL1}</span>
          <span class="v2-hero-l2">{s.hero.titleL2}</span>
        </h1>
        <p class="v2-hero-sub">{s.hero.sub}</p>
        <div class="v2-hero-cta">
          <a href={release.downloadUrl} data-dl-link class="v2-btn v2-btn--amber">
            <CarcaraLogo width={19} height={19} fill="#211C15" />
            {s.hero.ctaWindows}
          </a>
          <a href={LATEST_RELEASE_URL} target="_blank" rel="noopener" class="v2-btn v2-btn--ghost">
            {s.hero.ctaLinux}
          </a>
          <a href="#ide" class="v2-btn v2-btn--ghost">{s.hero.ctaSeeIde}</a>
        </div>
        <span class="v2-hero-meta">
          .exe &nbsp;·&nbsp; <span data-dl-version>{release.tag}</span> &nbsp;·&nbsp; {s.hero.metaFree} &nbsp;·&nbsp; {s.hero.metaOpen}
        </span>
      </div>

      <div class="v2-hero-visual">
        <div class="v2-mock-scaler"><IdeWindow lang={lang} /></div>
      </div>
    </div>
  </section>

  <!-- ===================== TRUST (faixa escura) ===================== -->
  <section class="v2band v2band--dark v2-trust">
    <div class="v2wrap v2-trust-row">
      <div class="v2-trust-item">
        <span class="v2-trust-big">{s.trust.freeBig}</span>
        <span class="v2-trust-sub">{s.trust.freeSub}</span>
      </div>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <div class="v2-trust-item">
        <span class="v2-trust-big">{s.trust.subBig}</span>
        <span class="v2-trust-sub">{s.trust.subSub}</span>
      </div>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <a href={REPO_URL} target="_blank" rel="noopener" class="v2-trust-item v2-trust-link">
        <span class="v2-trust-big">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#E7B368; vertical-align:-2px;"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9z"/></svg>
          <span>30+</span>
        </span>
        <span class="v2-trust-sub">{s.trust.starsSub}</span>
      </a>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <div class="v2-trust-item">
        <span class="v2-trust-big">{s.trust.osBig}</span>
        <span class="v2-trust-sub">{s.trust.osSub}</span>
      </div>
    </div>
  </section>

  <!-- ===================== MUITOS PROJETOS / carrossel (faixa papel) ===================== -->
  <section class="v2band v2band--paper" id="ide">
    <span id="recursos" aria-hidden="true" style="display:block; height:0;"></span>
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.ideSection.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.ideSection.h.a}<span class="v2-em">{s.ideSection.h.em}</span>{s.ideSection.h.b}</h2>
        <p>{s.ideSection.p}</p>
      </div>

      <div class="cc-carousel">
        <div class="cc-track" data-track>
          {slides.map((sl, i) => (
            <figure class="cc-slide">
              <div class="cc-slide-inner">
                <div class="cc-slide-frame">
                  <Image class="cc-shot-img" src={sl.img} alt={sl.alt} widths={[480, 640, 960]} sizes="(max-width:820px) 92vw, 540px" quality={82} loading="eager" />
                </div>
                <figcaption class="cc-slide-cap">
                  <span class="cc-slide-num">{String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}</span>
                  <h3>{sl.title}</h3>
                  <p>{sl.desc}</p>
                </figcaption>
              </div>
            </figure>
          ))}
        </div>

        <button type="button" class="cc-car-arrow cc-car-prev" data-prev aria-label={lang === 'en' ? 'Previous feature' : 'Recurso anterior'}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <button type="button" class="cc-car-arrow cc-car-next" data-next aria-label={lang === 'en' ? 'Next feature' : 'Próximo recurso'}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </button>

        <div class="cc-car-dots" data-dots>
          {slides.map((_, i) => (
            <button type="button" class="cc-dot" data-dot={i} aria-label={`${lang === 'en' ? 'Go to feature' : 'Ir para o recurso'} ${i + 1}`} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MULTIPLEXADOR (faixa creme) ===================== -->
  <section class="v2band" id="multiplexador">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker">{s.mux.kicker}</div>
        <h2>{s.mux.h.a}<span class="v2-em">{s.mux.h.em}</span>{s.mux.h.b}</h2>
        <p>{s.mux.p}</p>
      </div>

      <div class="v2-mux">
        {projects.slice(0, 3).map((p, i) => (
          <div class="v2-mux-card" data-active={i === 0 ? '' : undefined} style={`--c:${p.color};`}>
            <div class="v2-mux-top">
              <span class="v2-mux-ic">{letterOf(tx(p.name, lang))}</span>
              <span class="v2-mux-name">{tx(p.name, lang)}</span>
              <span class="v2-mux-live"><i></i>{s.mux.live}</span>
            </div>
            <div class="v2-mux-chat">
              <span class="v2-mux-msg">{tx(p.chat[0].text, lang)}</span>
            </div>
            <div class="v2-mux-foot">
              <span>{s.mux.chat}</span>
              <span>{s.mux.preview}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SELEÇÃO VISUAL (faixa papel) ===================== -->
  <section class="v2band v2band--paper" id="seletor">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.selector.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.selector.h.a}<span class="v2-em">{s.selector.h.em}</span>{s.selector.h.b}</h2>
        <p>{s.selector.p}</p>
      </div>

      <Seletor lang={lang} />

      <div class="v2-grid">
        <div class="v2-card">
          <div class="v2-card-ic">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg>
          </div>
          <h3>{s.selector.cards[0].title}</h3>
          <p>{s.selector.cards[0].body}</p>
        </div>
        <div class="v2-card">
          <div class="v2-card-ic">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z" /></svg>
          </div>
          <h3>{s.selector.cards[1].title}</h3>
          <p>{s.selector.cards[1].body}</p>
        </div>
        <div class="v2-card">
          <div class="v2-card-ic">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
          </div>
          <h3>{s.selector.cards[2].title}</h3>
          <p>{s.selector.cards[2].body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== VÍDEO ===================== -->
  <Demo lang={lang} />

  <!-- ===================== ASSINATURA (faixa âmbar) ===================== -->
  <section class="v2band v2band--amber">
    <div class="v2wrap v2sh">
      <div class="v2-kicker" set:html={s.assinatura.kicker.replace(/ /g, '&nbsp;')} />
      <h2>{s.assinatura.h.a}<span class="v2-em">{s.assinatura.h.em}</span>{s.assinatura.h.b}</h2>
      <p>{s.assinatura.p1}<strong>{s.assinatura.strong}</strong>{s.assinatura.p2}</p>
    </div>
  </section>

  <!-- ===================== COMPARATIVO (faixa escura) ===================== -->
  <section class="v2band v2band--dark">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.compare.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.compare.h.a}<span class="v2-em">{s.compare.h.em}</span>{s.compare.h.b}</h2>
        <p>{s.compare.p}</p>
      </div>
      <div class="v2-cmp">
        <div class="v2-cmp-col v2-cmp-before">
          <div class="v2-cmp-head">{s.compare.headBefore}</div>
          {compare.map(([before]) => (
            <div class="v2-cmp-row">
              <span class="v2-cmp-mark v2-cmp-mark--x">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.x} />
              </span>
              <span>{before}</span>
            </div>
          ))}
        </div>
        <div class="v2-cmp-col v2-cmp-after">
          <div class="v2-cmp-head">{s.compare.headAfter}</div>
          {compare.map(([, after]) => (
            <div class="v2-cmp-row">
              <span class="v2-cmp-mark v2-cmp-mark--check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.check} />
              </span>
              <span>{after}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FILOSOFIA (faixa creme) ===================== -->
  <section class="v2band">
    <div class="v2wrap v2-quote">
      <CarcaraLogo width={44} height={44} />
      <p class="v2-quote-big">{s.quote.big.a}<span class="v2-em">{s.quote.big.em}</span>{s.quote.big.b}</p>
      <p class="v2-quote-sub">{s.quote.sub}</p>
    </div>
  </section>

  <!-- ===================== COMO COMEÇAR (timeline vertical, faixa papel) ===================== -->
  <section class="v2band v2band--paper">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.start.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.start.h.a}<span class="v2-em">{s.start.h.em}</span>{s.start.h.b}</h2>
        <p>{s.start.p}</p>
      </div>

      <ol class="v2-tl">
        <!-- passo 1 -->
        <li class="v2-tl-step">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot">1</span>
            <span class="v2-tl-line"></span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.s1Title}</h3>
            <p>{s.start.s1Body}</p>
            <div class="v2-tl-mock">
              <div class="v2-tl-term">
                <span class="v2-tl-term-bar"><i></i><i></i><i></i></span>
                <code><span class="v2-tl-prompt">$</span> npm i -g @anthropic-ai/claude-code</code>
                <code><span class="v2-tl-prompt">$</span> claude login</code>
                <code class="v2-tl-ok">{s.start.s1Ok}</code>
              </div>
            </div>
          </div>
        </li>

        <!-- passo 2 -->
        <li class="v2-tl-step">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot">2</span>
            <span class="v2-tl-line"></span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.s2Title}</h3>
            <p>{s.start.s2Body}</p>
            <div class="v2-tl-mock">
              <div class="v2-tl-dlcard">
                <span class="v2-tl-dl-ic"><CarcaraLogo width={18} height={18} fill="#211C15" /></span>
                <div class="v2-tl-dl-txt">
                  <strong data-dl-filename>{release.fileName}</strong>
                  <span data-dl-meta>{release.tag} · {release.size} · {release.date}</span>
                </div>
                <span class="v2-tl-dl-badge">.exe</span>
              </div>
            </div>
          </div>
        </li>

        <!-- passo 3 -->
        <li class="v2-tl-step">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot">3</span>
            <span class="v2-tl-line"></span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.s3Title}</h3>
            <p>{s.start.s3Body}</p>
            <div class="v2-tl-mock">
              <div class="v2-tl-rail-mock">
                {projects.slice(0, 5).map((p, i) => (
                  <span class="v2-tl-proj" style={`--c:${p.color}; animation-delay:${i}s;`} data-active={i === 0 ? '' : undefined}>{letterOf(tx(p.name, lang))}</span>
                ))}
                <span class="v2-tl-proj-add">+</span>
              </div>
            </div>
          </div>
        </li>

        <!-- pronto -->
        <li class="v2-tl-step v2-tl-step--done">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot v2-tl-dot--done">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.doneTitle}</h3>
            <p>{s.start.doneBody}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <Faq lang={lang} />

  <!-- ===================== DOWNLOAD / CTA final (faixa âmbar) ===================== -->
  <section class="v2band v2band--amber" id="download">
    <div class="v2wrap v2-dl-grid">
      <div class="v2-dl-art">
        <img src="/carcara.png" alt={s.download.artAlt} width="900" height="675" loading="lazy" />
      </div>
      <div class="v2-dl-card">
        <div class="v2-kicker">{s.download.kicker}</div>
        <h2 class="v2-dl-title">{s.download.title.a}<span class="v2-em">{s.download.title.em}</span>{s.download.title.b}</h2>
        <p class="v2-dl-lead">{s.download.lead}</p>

        <ul class="v2-dl-chips">
          {s.download.chips.map((chip) => <li>{chip}</li>)}
        </ul>

        <div class="v2-dl-actions">
          <a href={release.downloadUrl} data-dl-link class="v2-dl-btn">
            <CarcaraLogo width={24} height={24} fill="#F6EFE2" />
            <span>{s.download.btnWindows}</span>
            <!-- ícone de download em pixel art (sprite): seta pra baixo + bandeja -->
            <svg class="v2-dl-btn-arrow" width="18" height="18" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
              <rect x="4" y="0" width="2" height="2" /><rect x="6" y="0" width="2" height="2" />
              <rect x="4" y="2" width="2" height="2" /><rect x="6" y="2" width="2" height="2" />
              <rect x="0" y="4" width="2" height="2" /><rect x="2" y="4" width="2" height="2" /><rect x="4" y="4" width="2" height="2" /><rect x="6" y="4" width="2" height="2" /><rect x="8" y="4" width="2" height="2" /><rect x="10" y="4" width="2" height="2" />
              <rect x="2" y="6" width="2" height="2" /><rect x="4" y="6" width="2" height="2" /><rect x="6" y="6" width="2" height="2" /><rect x="8" y="6" width="2" height="2" />
              <rect x="4" y="8" width="2" height="2" /><rect x="6" y="8" width="2" height="2" />
              <rect x="0" y="10" width="2" height="2" /><rect x="2" y="10" width="2" height="2" /><rect x="4" y="10" width="2" height="2" /><rect x="6" y="10" width="2" height="2" /><rect x="8" y="10" width="2" height="2" /><rect x="10" y="10" width="2" height="2" /></svg>
          </a>
          <a href={LATEST_RELEASE_URL} target="_blank" rel="noopener" class="v2-btn v2-btn--ghost v2-dl-btn-secondary">
            {s.download.btnLinux}
          </a>
        </div>

        <div class="v2-dl-meta">
          <span data-dl-filename>{release.fileName}</span> · <span data-dl-meta>{release.tag} · {release.size} · {release.date}</span>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- anima o rail do mock: cicla projeto ativo + troca chat/preview com crossfade -->
  <ProjectRailScript />

  <!-- atualiza link/versão de download com a última release do GitHub (client-side) -->
  <RefreshReleaseScript />
</Layout>

<style>
  /* ===== Sistema de faixas ===== */
  .v2band {
    width: 100%;
  }
  .v2band--paper {
    background: #fbf8f1;
    border-top: 1px solid #ece4d5;
    border-bottom: 1px solid #ece4d5;
  }
  .v2band--dark {
    background: #1e1913;
    color: #ede7dd;
  }
  .v2band--amber {
    background:
      radial-gradient(120% 90% at 50% -20%, rgba(255, 243, 220, 0.95) 0%, rgba(255, 243, 220, 0) 55%),
      linear-gradient(180deg, #f3d199 0%, #ecbd77 100%);
  }
  .v2wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 100px) clamp(20px, 5vw, 56px);
  }

  /* ===== Cabeçalho de seção ===== */
  .v2sh {
    text-align: center;
    max-width: 46em;
    margin-left: auto;
    margin-right: auto;
  }
  .v2sh > .v2-grid,
  .v2sh > .v2-cmp,
  .v2sh > .v2-steps {
    text-align: left;
  }
  .v2-kicker {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: #b07d2f;
    margin-bottom: 16px;
  }
  .v2band--dark .v2-kicker {
    color: #e7b368;
  }
  .v2band--amber .v2-kicker {
    color: #5e3f12;
  }
  .v2sh h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(30px, 4.4vw, 54px);
    line-height: 1.04;
    margin: 0 0 14px;
    color: #211c15;
  }
  .v2band--dark .v2sh h2 {
    color: #f3ede1;
  }
  .v2band--amber .v2sh h2 {
    color: #2a2410;
  }
  .v2-em {
    font-style: italic;
    color: #c5821c;
  }
  .v2band--dark .v2-em {
    color: #e7b368;
  }
  .v2band--amber .v2-em {
    color: #6b3f0a;
  }
  .v2sh p {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    color: #5c5347;
    margin: 0 auto;
  }
  .v2band--dark .v2sh p {
    color: #c3b8a5;
  }
  .v2band--amber .v2sh p {
    color: #4a3a1a;
  }
  .v2band--amber .v2sh strong {
    color: #2a2410;
    font-weight: 800;
  }

  /* ===== Botões ===== */
  .v2-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 16.5px;
    text-decoration: none;
    padding: 15px 26px;
    border-radius: 12px;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .v2-btn--amber {
    color: #211c15;
    background: #d99748;
    box-shadow: 0 4px 0 #a06f2e, 0 10px 24px rgba(160, 111, 46, 0.3);
  }
  .v2-btn--amber:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #a06f2e, 0 14px 30px rgba(160, 111, 46, 0.34);
  }
  .v2-btn--ghost {
    color: #3a342b;
    background: transparent;
    border: 1px solid #d8cfbe;
  }
  .v2-btn--ghost:hover {
    border-color: #c5821c;
  }
  .v2-btn--dark {
    color: #f3ede1;
    background: #211c15;
    box-shadow: 0 6px 18px rgba(33, 28, 21, 0.35);
  }
  .v2-btn--dark:hover {
    transform: translateY(-2px);
  }

  /* ===== Hero ===== */
  .v2-hero .v2wrap {
    padding-top: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .v2-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .v2-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'Press Start 2P', monospace;
    font-size: 9.5px;
    color: #b07d2f;
    letter-spacing: 0.05em;
    margin-bottom: 26px;
    background: #fbf8f1;
    border: 1px solid #e7e0d2;
    padding: 8px 12px;
    border-radius: 999px;
  }
  .v2-badge-static {
    white-space: nowrap;
  }
  /* efeito terminal: apaga a IA atual e digita a próxima */
  .v2-badge-rotator {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .v2-badge-type {
    white-space: pre;
  }
  .v2-badge-caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 1px;
    background: currentColor;
    animation: v2-badge-blink 1s steps(1) infinite;
  }
  @keyframes v2-badge-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-badge-caret {
      animation: none;
    }
  }
  .v2-hero-title {
    margin: 0 0 22px;
  }
  .v2-hero-l1 {
    display: block;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 5.4vw, 70px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: #211c15;
  }
  .v2-hero-l2 {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(44px, 6vw, 78px);
    line-height: 1;
    color: #c5821c;
  }
  .v2-hero-sub {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: #5c5347;
    max-width: 30em;
    margin: 0 0 32px;
  }
  .v2-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 13px;
  }
  .v2-hero-meta {
    display: block;
    margin-top: 15px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #8a8073;
    letter-spacing: 0.02em;
  }
  /* Frame 16/9: o mock é renderizado numa largura fixa "de design" (850px, onde
     já nasce confortável e ~16/9) e ESCALADO por JS pra caber no frame. Assim os
     elementos encolhem TODOS juntos, em vez de ficarem grandes num quadro
     apertado. */
  .v2-hero-visual {
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 28px 60px -20px rgba(110, 80, 30, 0.45),
      0 10px 22px -12px rgba(110, 80, 30, 0.22);
  }
  .v2-mock-scaler {
    width: 850px;
    transform-origin: top left;
    will-change: transform;
  }
  .v2-mock-scaler > :global(div) {
    box-shadow: none;
    border-radius: 16px;
  }

  /* ===== Trust strip ===== */
  .v2-trust .v2wrap {
    padding-top: clamp(26px, 3vw, 38px);
    padding-bottom: clamp(26px, 3vw, 38px);
  }
  .v2-trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 40px);
    text-align: center;
  }
  .v2-trust-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
  }
  .v2-trust-big {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(18px, 2vw, 23px);
    color: #f3ede1;
  }
  .v2-trust-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: #9a8f7c;
    letter-spacing: 0.02em;
  }
  .v2-trust-link:hover .v2-trust-big {
    color: #e7b368;
  }
  .v2-trust-div {
    width: 1px;
    height: 34px;
    background: rgba(237, 231, 221, 0.16);
  }

  /* ===== Grade de recursos ===== */
  .v2-grid {
    margin-top: clamp(32px, 4vw, 52px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .v2-card {
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 16px;
    padding: clamp(22px, 2.6vw, 30px);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .v2-card:hover {
    transform: translateY(-3px);
    border-color: #e2cfa8;
    box-shadow: 0 14px 34px rgba(160, 111, 46, 0.12);
  }
  .v2-card-ic {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: #fbf1df;
    color: #c5821c;
    margin-bottom: 16px;
  }
  .v2-card h3 {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 18.5px;
    margin: 0 0 7px;
    color: #211c15;
  }
  .v2-card p {
    font-size: 15px;
    line-height: 1.55;
    color: #5c5347;
    margin: 0;
  }

  /* ===== Comparativo ===== */
  .v2-cmp {
    margin-top: clamp(32px, 4vw, 52px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .v2-cmp-col {
    border-radius: 16px;
    padding: clamp(22px, 2.6vw, 30px);
  }
  .v2-cmp-before {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(237, 231, 221, 0.1);
  }
  .v2-cmp-after {
    background: rgba(217, 151, 72, 0.1);
    border: 1px solid rgba(217, 151, 72, 0.34);
  }
  .v2-cmp-head {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.05em;
    margin-bottom: 18px;
  }
  .v2-cmp-before .v2-cmp-head {
    color: #8a8073;
  }
  .v2-cmp-after .v2-cmp-head {
    color: #e7b368;
  }
  .v2-cmp-row {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 11px 0;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15.5px;
    line-height: 1.45;
    border-top: 1px solid rgba(237, 231, 221, 0.08);
  }
  .v2-cmp-before .v2-cmp-row {
    color: #b0a795;
  }
  .v2-cmp-after .v2-cmp-row {
    color: #ede7dd;
  }
  .v2-cmp-mark {
    flex: none;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin-top: 1px;
  }
  .v2-cmp-mark--x {
    background: rgba(237, 231, 221, 0.08);
    color: #8a8073;
  }
  .v2-cmp-mark--check {
    background: #d99748;
    color: #211c15;
  }

  /* ===== Filosofia ===== */
  .v2-quote {
    max-width: 760px;
    text-align: center;
  }
  .v2-quote-big {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.12;
    color: #211c15;
    margin: 18px 0;
  }
  .v2-quote-sub {
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.55;
    color: #5c5347;
    max-width: 34em;
    margin: 0 auto;
  }

  /* ===== Multiplexador ===== */
  .v2-mux {
    margin-top: clamp(32px, 4vw, 52px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .v2-mux-card {
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .v2-mux-card[data-active] {
    border-color: #e2cfa8;
    box-shadow: 0 16px 36px -16px var(--c);
    transform: translateY(-4px);
  }
  .v2-mux-top {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .v2-mux-ic {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 13px;
    color: #fff;
    background: var(--c);
  }
  .v2-mux-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: #211c15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .v2-mux-live {
    margin-left: auto;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #5ba86b;
  }
  .v2-mux-live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5ba86b;
    box-shadow: 0 0 0 3px rgba(91, 168, 107, 0.18);
  }
  .v2-mux-chat {
    background: #fbf8f1;
    border: 1px solid #efe8da;
    border-radius: 10px;
    padding: 10px 12px;
    min-height: 62px;
  }
  .v2-mux-msg {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12.5px;
    line-height: 1.45;
    color: #5c5347;
  }
  .v2-mux-foot {
    display: flex;
    gap: 8px;
  }
  .v2-mux-foot span {
    flex: 1;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a8073;
    background: #faf6ee;
    border: 1px solid #efe8da;
    border-radius: 7px;
    padding: 6px 4px;
  }

  /* ===== Como começar (timeline vertical) ===== */
  .v2-tl {
    list-style: none;
    margin: clamp(32px, 4vw, 48px) auto 0;
    padding: 0;
    max-width: 620px;
  }
  .v2-tl-step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 18px;
  }
  .v2-tl-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .v2-tl-dot {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 16px;
    color: #fff;
    background: #d99748;
    box-shadow: 0 0 0 5px rgba(217, 151, 72, 0.16);
  }
  .v2-tl-dot--done {
    background: #5ba86b;
    box-shadow: 0 0 0 5px rgba(91, 168, 107, 0.16);
  }
  .v2-tl-line {
    flex: 1;
    width: 2px;
    margin: 6px 0;
    background: linear-gradient(to bottom, rgba(217, 151, 72, 0.7), #e7e0d2);
    border-radius: 2px;
  }
  .v2-tl-body {
    min-width: 0;
    padding-bottom: clamp(28px, 4vw, 40px);
  }
  .v2-tl-step--done .v2-tl-body {
    padding-bottom: 0;
  }
  .v2-tl-body h3 {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 18px;
    margin: 7px 0 6px;
    color: #211c15;
  }
  .v2-tl-body > p {
    font-size: 15px;
    line-height: 1.55;
    color: #5c5347;
    margin: 0;
  }
  .v2-tl-mock {
    margin-top: 16px;
  }
  /* mini terminal (passo 1) */
  .v2-tl-term {
    background: #1c1811;
    border: 1px solid #2c261c;
    border-radius: 12px;
    padding: 12px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    line-height: 1.85;
    color: #d8cdb8;
    overflow-x: auto;
  }
  .v2-tl-term-bar {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }
  .v2-tl-term-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #4a4235;
  }
  .v2-tl-term code {
    display: block;
    white-space: nowrap;
  }
  .v2-tl-prompt {
    color: #d99748;
    margin-right: 7px;
  }
  .v2-tl-ok {
    color: #7bbf87;
  }
  /* mini card de download (passo 2) */
  .v2-tl-dlcard {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 12px;
    padding: 12px 14px;
  }
  .v2-tl-dl-ic {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: #fbf1df;
    display: grid;
    place-items: center;
  }
  .v2-tl-dl-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .v2-tl-dl-txt strong {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 13.5px;
    color: #211c15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .v2-tl-dl-txt span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #8a8073;
  }
  .v2-tl-dl-badge {
    margin-left: auto;
    flex: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: #b07d2f;
    background: #fbf1df;
    border: 1px solid #e7cfa4;
    border-radius: 6px;
    padding: 3px 8px;
  }
  /* mini rail de projetos (passo 3) */
  .v2-tl-rail-mock {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 12px;
    padding: 12px 14px;
    flex-wrap: wrap;
  }
  .v2-tl-proj {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 14px;
    color: var(--c);
    background: #fff;
    border: 1.5px solid #e7e0d2;
    /* alternância do ícone ativo: cada ícone acende na sua vez (delay por índice,
       5 ícones num ciclo de 5s), imitando o rail do hero trocando de projeto. */
    animation: ccRailHop 5s ease-in-out infinite;
  }
  .v2-tl-proj[data-active] {
    color: #fff;
    background: var(--c);
    border-color: var(--c);
    box-shadow: 0 4px 12px -3px var(--c);
  }
  @keyframes ccRailHop {
    0%, 100% {
      color: var(--c);
      background: #fff;
      border-color: #e7e0d2;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transform: scale(1);
    }
    8%, 16% {
      color: #fff;
      background: var(--c);
      border-color: var(--c);
      box-shadow: 0 5px 13px -3px var(--c);
      transform: scale(1.08);
    }
    24% {
      color: var(--c);
      background: #fff;
      border-color: #e7e0d2;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-tl-proj {
      animation: none;
    }
  }
  .v2-tl-proj-add {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-size: 18px;
    color: #b3a78f;
    border: 1.5px dashed #d8cfbe;
  }

  /* ===== Download final (card + carcará em pixel art ao lado) ===== */
  .v2-dl-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
  }
  .v2-dl-art {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .v2-dl-art img {
    width: 100%;
    max-width: 460px;
    height: auto;
    filter: drop-shadow(0 22px 30px rgba(90, 60, 15, 0.28));
  }
  .v2-dl-card {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    background: rgba(255, 251, 243, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 26px;
    padding: clamp(32px, 5vw, 52px) clamp(22px, 4vw, 48px);
    box-shadow: 0 24px 60px -24px rgba(120, 78, 20, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(6px);
  }
  .v2-dl-title {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.02;
    margin: 12px 0;
    color: #2a2410;
  }
  .v2-dl-lead {
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.5;
    color: #5a4a22;
    margin: 0 auto 22px;
    max-width: 30em;
  }
  .v2-dl-chips {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .v2-dl-chips li {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: #6b551f;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(160, 111, 46, 0.25);
    border-radius: 999px;
    padding: 6px 13px;
  }
  .v2-dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(17px, 1.7vw, 20px);
    color: #f6efe2;
    background: linear-gradient(180deg, #2c2519 0%, #1c1710 100%);
    text-decoration: none;
    padding: 18px 34px;
    border-radius: 15px;
    box-shadow: 0 8px 0 #a06f2e, 0 18px 34px -8px rgba(120, 78, 20, 0.6);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
    animation: v2dlpulse 2.6s ease-in-out infinite;
  }
  .v2-dl-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 11px 0 #a06f2e, 0 24px 42px -8px rgba(120, 78, 20, 0.68);
  }
  .v2-dl-btn-arrow {
    color: #d99748;
    transition: transform 0.18s ease;
  }
  .v2-dl-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 13px;
  }
  .v2-dl-btn-secondary {
    color: #6b551f;
  }
  .v2-dl-btn:hover .v2-dl-btn-arrow {
    transform: translateY(3px);
  }
  @keyframes v2dlpulse {
    0%,
    100% {
      box-shadow: 0 8px 0 #a06f2e, 0 18px 34px -8px rgba(120, 78, 20, 0.6);
    }
    50% {
      box-shadow: 0 8px 0 #a06f2e, 0 18px 40px -6px rgba(217, 151, 72, 0.78);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-dl-btn {
      animation: none;
    }
  }
  .v2-dl-meta {
    margin-top: 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #6b551f;
  }

  /* ===== Carrossel (mesma mecânica da index) ===== */
  .cc-carousel {
    position: relative;
    margin-top: clamp(32px, 4vw, 52px);
  }
  .cc-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .cc-track::-webkit-scrollbar {
    display: none;
  }
  .cc-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: center;
    margin: 0;
    padding: 0 2px;
  }
  /* imagem de um lado, texto do outro (centralizados verticalmente) */
  .cc-slide-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(22px, 4vw, 48px);
    align-items: center;
    padding: 0 clamp(38px, 5vw, 60px);
  }
  .cc-slide-frame {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(33, 28, 21, 0.12);
    box-shadow: 0 16px 40px rgba(110, 80, 30, 0.14);
    line-height: 0;
    background: #1a1a1a;
  }
  .cc-shot-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cc-slide-cap {
    text-align: left;
    max-width: none;
    margin: 0;
  }
  .cc-slide-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: #b07d2f;
    letter-spacing: 0.04em;
  }
  .cc-slide-cap h3 {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(19px, 2.2vw, 26px);
    margin: 6px 0 6px;
    color: #211c15;
  }
  .cc-slide-cap p {
    font-size: clamp(14.5px, 1.4vw, 16.5px);
    line-height: 1.55;
    color: #5c5347;
    margin: 0;
  }
  .cc-car-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #211c15;
    background: rgba(251, 248, 241, 0.92);
    border: 1px solid #e7e0d2;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(110, 80, 30, 0.18);
    transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
    z-index: 2;
  }
  .cc-car-prev {
    left: -6px;
  }
  .cc-car-next {
    right: -6px;
  }
  .cc-car-arrow:hover {
    transform: translateY(-50%) scale(1.07);
    border-color: #d99748;
    background: #fff;
  }
  .cc-car-arrow:disabled {
    opacity: 0.35;
    cursor: default;
    transform: translateY(-50%);
  }
  .cc-car-dots {
    display: flex;
    justify-content: center;
    gap: 9px;
    margin-top: 20px;
  }
  .cc-dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #d8cfbe;
    cursor: pointer;
    transition: background 0.18s ease, width 0.18s ease;
  }
  .cc-dot[data-active] {
    background: #d99748;
    width: 26px;
  }

  /* ===== Responsivo ===== */
  @media (max-width: 900px) {
    .v2-hero-grid {
      grid-template-columns: 1fr;
    }
    .v2-cmp {
      grid-template-columns: 1fr;
    }
    .v2-mux {
      grid-template-columns: 1fr;
    }
    .v2-dl-grid {
      grid-template-columns: 1fr;
    }
    .v2-dl-art {
      order: -1;
    }
    .v2-dl-art img {
      max-width: 300px;
    }
  }
  @media (max-width: 760px) {
    /* carrossel empilha: imagem em cima, texto embaixo */
    .cc-slide-inner {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 0 44px;
    }
    .cc-slide-cap {
      text-align: center;
    }
  }
  @media (max-width: 640px) {
    .v2-steps {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .v2-trust-div {
      display: none;
    }
    .cc-car-arrow {
      display: none;
    }
