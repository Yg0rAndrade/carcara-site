---

<Layout lang={lang}>
  <Nav lang={lang} />

  <!-- ===================== HERO (faixa creme) ===================== -->
  <section class="v2band v2-hero">
    <div class="v2wrap v2-hero-grid">
      <div>
        <div class="v2-badge">
          <CarcaraLogo width={14} height={14} />
          <span class="v2-badge-static" set:html={s.hero.badgeStatic.replace(/ /g, '&nbsp;')} />
          <span class="v2-badge-rotator" aria-live="polite"><span class="v2-badge-type">CLAUDE&nbsp;CODE</span><span class="v2-badge-caret" aria-hidden="true"></span></span>
        </div>
        <h1 class="v2-hero-title">
          <span class="v2-hero-l1">{s.hero.titleL1}</span>
          <span class="v2-hero-l2">{s.hero.titleL2}</span>
        </h1>
        <p class="v2-hero-sub">{s.hero.sub}</p>
        <div class="v2-hero-cta">
          <a href={release.downloadUrl} data-dl-win class="v2-btn v2-btn--amber v2-dl-primary">
            <PlatformIcon os="windows" width={19} height={19} fill="#211C15" />
            {s.hero.ctaWindows}
          </a>
          <div class="v2-hero-alts">
            <a href={release.macUrl} data-dl-mac class="v2-btn v2-btn--ghost v2-dl-alt">
              <PlatformIcon os="mac" width={17} height={17} fill="#211C15" />
              Mac
            </a>
            <a href={release.linuxUrl} data-dl-linux class="v2-btn v2-btn--ghost v2-dl-alt">
              <PlatformIcon os="linux" width={17} height={17} fill="#211C15" />
              {s.hero.ctaLinux}
            </a>
          </div>
          <a href={baixarHref} class="v2-hero-allopts">
            {allOptionsLabel}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
          </a>
        </div>
        <span class="v2-hero-meta">
          <span data-dl-version>{release.tag}</span> &nbsp;·&nbsp; Windows, Mac &amp; Linux &nbsp;·&nbsp; {s.hero.metaFree} &nbsp;·&nbsp; {s.hero.metaOpen}
        </span>
      </div>

      <div class="v2-hero-visual">
        <div class="v2-mock-scaler"><IdeWindow lang={lang} /></div>
      </div>
    </div>
  </section>

  <!-- ===================== TRUST (faixa escura) ===================== -->
  <section class="v2band v2band--dark v2-trust">
    <div class="v2wrap v2-trust-row">
      <div class="v2-trust-item">
        <span class="v2-trust-big">{s.trust.freeBig}</span>
        <span class="v2-trust-sub">{s.trust.freeSub}</span>
      </div>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <div class="v2-trust-item">
        <span class="v2-trust-big">{s.trust.subBig}</span>
        <span class="v2-trust-sub">{s.trust.subSub}</span>
      </div>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <a href={REPO_URL} target="_blank" rel="noopener" class="v2-trust-item v2-trust-link">
        <span class="v2-trust-big">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#E7B368; vertical-align:-2px;"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9z"/></svg>
          <span data-gh-stars data-gh-stars-prefix="" data-gh-stars-countup>{stars != null ? formatStars(stars) : '30+'}</span>
        </span>
        <span class="v2-trust-sub">{s.trust.starsSub}</span>
        <span class="v2-trust-hint">{s.trust.starsHint}</span>
      </a>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <div class="v2-trust-item">
        <span class="v2-trust-big">{s.trust.osBig}</span>
        <span class="v2-trust-sub">{s.trust.osSub}</span>
      </div>
    </div>
  </section>

  <!-- ===================== AVALIAÇÕES / DEPOIMENTOS (faixa creme) ===================== -->
  <section class="v2band" id="avaliacoes">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker">{avaliacoes.kicker}</div>
        <h2>{avaliacoes.hA}<span class="v2-em">{avaliacoes.hEm}</span>{avaliacoes.hB}</h2>
        <p>{avaliacoes.p}</p>
      </div>

      <div class="v2-reviews">
        {depoimentos.map((d) => (
          <figure class="v2-review" style={`--c:${d.cor};`}>
            <div class="v2-review-stars" aria-label={lang === 'pt' ? '5 de 5 estrelas' : '5 out of 5 stars'}>
              {Array.from({ length: 5 }).map(() => (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={ICON.star} />
              ))}
            </div>
            <blockquote class="v2-review-text">{d.texto}</blockquote>
            <figcaption class="v2-review-who">
              <Image class="v2-review-av" src={d.foto} alt={d.nome} width={88} height={88} loading="lazy" />
              <span class="v2-review-name">{d.nome}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== MUITOS PROJETOS / carrossel (faixa papel) ===================== -->
  <section class="v2band v2band--paper" id="ide">
    <span id="recursos" aria-hidden="true" style="display:block; height:0;"></span>
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.ideSection.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.ideSection.h.a}<span class="v2-em">{s.ideSection.h.em}</span>{s.ideSection.h.b}</h2>
        <p>{s.ideSection.p}</p>
      </div>

      <div class="cc-carousel">
        <div class="cc-track" data-track>
          {slides.map((sl, i) => (
            <figure class="cc-slide">
              <div class="cc-slide-inner">
                <div class="cc-slide-frame">
                  <Image class="cc-shot-img" src={sl.img} alt={sl.alt} widths={[480, 640, 960]} sizes="(max-width:820px) 92vw, 540px" quality={82} loading="eager" />
                </div>
                <figcaption class="cc-slide-cap">
                  <span class="cc-slide-num">{String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}</span>
                  <h3>{sl.title}</h3>
                  <p>{sl.desc}</p>
                </figcaption>
              </div>
            </figure>
          ))}
        </div>

        <button type="button" class="cc-car-arrow cc-car-prev" data-prev aria-label={lang === 'pt' ? 'Recurso anterior' : 'Previous feature'}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <button type="button" class="cc-car-arrow cc-car-next" data-next aria-label={lang === 'pt' ? 'Próximo recurso' : 'Next feature'}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </button>

        <div class="cc-car-dots" data-dots>
          {slides.map((_, i) => (
            <button type="button" class="cc-dot" data-dot={i} aria-label={`${lang === 'pt' ? 'Ir para o recurso' : 'Go to feature'} ${i + 1}`} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MULTIPLEXADOR (faixa creme) ===================== -->
  <section class="v2band" id="multiplexador">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker">{s.mux.kicker}</div>
        <h2>{s.mux.h.a}<span class="v2-em">{s.mux.h.em}</span>{s.mux.h.b}</h2>
        <p>{s.mux.p}</p>
      </div>

      <div class="v2-mux">
        {projects.slice(0, 3).map((p, i) => (
          <div class="v2-mux-card" data-active={i === 0 ? '' : undefined} style={`--c:${p.color};`}>
            <div class="v2-mux-top">
              <span class="v2-mux-ic">{letterOf(tx(p.name, lang))}</span>
              <span class="v2-mux-name">{tx(p.name, lang)}</span>
              <span class="v2-mux-live"><i></i>{s.mux.live}</span>
            </div>
            <div class="v2-mux-chat">
              <span class="v2-mux-msg">{tx(p.chat[0].text, lang)}</span>
            </div>
            <div class="v2-mux-foot">
              <span>{s.mux.chat}</span>
              <span>{s.mux.preview}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== QUALQUER STACK (faixa papel) ===================== -->
  <section class="v2band v2band--paper" id="stacks">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker">{s.stacks.kicker}</div>
        <h2>{s.stacks.h.a}<span class="v2-em">{s.stacks.h.em}</span>{s.stacks.h.b}</h2>
        <p>{s.stacks.p}</p>
      </div>

      <div class="v2-stacks">
        {s.stacks.items.map((name) => {
          const ic = STACK_ICONS[name];
          return (
            <span class="v2-stack-chip">
              {ic && (
                <svg class="v2-stack-ic" viewBox="0 0 24 24" width="18" height="18" fill={`#${ic.hex}`} aria-hidden="true" set:html={`<path d="${ic.path}"/>`} />
              )}
              {name}
            </span>
          );
        })}
        <span class="v2-stack-chip v2-stack-chip--more">{s.stacks.note}</span>
      </div>
    </div>
  </section>

  <!-- ===================== SELEÇÃO VISUAL (faixa creme) ===================== -->
  <section class="v2band" id="seletor">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.selector.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.selector.h.a}<span class="v2-em">{s.selector.h.em}</span>{s.selector.h.b}</h2>
        <p>{s.selector.p}</p>
      </div>

      <Seletor lang={lang} />

      <div class="v2-grid">
        <div class="v2-card">
          <div class="v2-card-ic">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="7" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg>
          </div>
          <h3>{s.selector.cards[0].title}</h3>
          <p>{s.selector.cards[0].body}</p>
        </div>
        <div class="v2-card">
          <div class="v2-card-ic">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z" /></svg>
          </div>
          <h3>{s.selector.cards[1].title}</h3>
          <p>{s.selector.cards[1].body}</p>
        </div>
        <div class="v2-card">
          <div class="v2-card-ic">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
          </div>
          <h3>{s.selector.cards[2].title}</h3>
          <p>{s.selector.cards[2].body}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== VÍDEO ===================== -->
  <Demo lang={lang} />

  <!-- ===================== ASSINATURA (faixa âmbar) ===================== -->
  <section class="v2band v2band--amber">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.assinatura.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.assinatura.h.a}<span class="v2-em">{s.assinatura.h.em}</span>{s.assinatura.h.b}</h2>
        <p>{s.assinatura.p1}<strong>{s.assinatura.strong}</strong>{s.assinatura.p2}</p>
      </div>

      <!-- Carrossel de IAs de código suportadas, flutuando (marquee + bob). -->
      <div class="v2-ai-label">{aiWorksWith}</div>
      <div class="v2-ai-mq">
        <div class="v2-ai-track">
          {[...aiLogos, ...aiLogos].map((ai, i) => (
            <span
              class="v2-ai-chip"
              aria-hidden={i >= aiLogos.length ? 'true' : undefined}
              data-dup={i >= aiLogos.length ? '' : undefined}
            >
              <span class="v2-ai-ic" style={ai.color ? `color:${ai.color}` : undefined} set:html={ai.svg} />
              <span class="v2-ai-name">{ai.name}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== COMPARATIVO (faixa escura) ===================== -->
  <section class="v2band v2band--dark">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.compare.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.compare.h.a}<span class="v2-em">{s.compare.h.em}</span>{s.compare.h.b}</h2>
        <p>{s.compare.p}</p>
      </div>
      <div class="v2-cmp">
        <div class="v2-cmp-col v2-cmp-before">
          <div class="v2-cmp-head">{s.compare.headBefore}</div>
          {compare.map(([before]) => (
            <div class="v2-cmp-row">
              <span class="v2-cmp-mark v2-cmp-mark--x">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.x} />
              </span>
              <span>{before}</span>
            </div>
          ))}
        </div>
        <div class="v2-cmp-col v2-cmp-after">
          <div class="v2-cmp-head">{s.compare.headAfter}</div>
          {compare.map(([, after]) => (
            <div class="v2-cmp-row">
              <span class="v2-cmp-mark v2-cmp-mark--check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.check} />
              </span>
              <span>{after}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== COMO COMEÇAR (timeline vertical, faixa papel) ===================== -->
  <section class="v2band v2band--paper">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker" set:html={s.start.kicker.replace(/ /g, '&nbsp;')} />
        <h2>{s.start.h.a}<span class="v2-em">{s.start.h.em}</span>{s.start.h.b}</h2>
        <p>{s.start.p}</p>
      </div>

      <ol class="v2-tl">
        <!-- passo 1 -->
        <li class="v2-tl-step">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot">1</span>
            <span class="v2-tl-line"></span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.s1Title}</h3>
            <p>{s.start.s1Body}</p>
            <div class="v2-tl-mock">
              <div class="v2-tl-term">
                <span class="v2-tl-term-bar"><i></i><i></i><i></i></span>
                <code><span class="v2-tl-prompt">$</span> npm i -g @anthropic-ai/claude-code</code>
                <code><span class="v2-tl-prompt">$</span> claude login</code>
                <code class="v2-tl-ok">{s.start.s1Ok}</code>
              </div>
            </div>
          </div>
        </li>

        <!-- passo 2 -->
        <li class="v2-tl-step">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot">2</span>
            <span class="v2-tl-line"></span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.s2Title}</h3>
            <p>{s.start.s2Body}</p>
            <div class="v2-tl-mock">
              <div class="v2-tl-dlcard">
                <span class="v2-tl-dl-ic"><CarcaraLogo width={18} height={18} fill="#211C15" /></span>
                <div class="v2-tl-dl-txt">
                  <strong data-dl-filename>{release.fileName}</strong>
                  <span data-dl-meta>{release.tag} · {release.size} · {release.date}</span>
                </div>
                <span class="v2-tl-dl-badge">.exe</span>
              </div>
            </div>
          </div>
        </li>

        <!-- passo 3 -->
        <li class="v2-tl-step">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot">3</span>
            <span class="v2-tl-line"></span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.s3Title}</h3>
            <p>{s.start.s3Body}</p>
            <div class="v2-tl-mock">
              <div class="v2-tl-rail-mock">
                {projects.slice(0, 5).map((p, i) => (
                  <span class="v2-tl-proj" style={`--c:${p.color}; animation-delay:${i}s;`} data-active={i === 0 ? '' : undefined}>{letterOf(tx(p.name, lang))}</span>
                ))}
                <span class="v2-tl-proj-add">+</span>
              </div>
            </div>
          </div>
        </li>

        <!-- pronto -->
        <li class="v2-tl-step v2-tl-step--done">
          <div class="v2-tl-rail">
            <span class="v2-tl-dot v2-tl-dot--done">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
          </div>
          <div class="v2-tl-body">
            <h3>{s.start.doneTitle}</h3>
            <p>{s.start.doneBody}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ===================== SKILL START (faixa escura, link p/ /comecar) ===================== -->
  <section class="v2band v2band--dark">
    <div class="v2wrap v2-ss">
      <div class="v2-ss-txt">
        <div class="v2-kicker">{comecar.kicker}</div>
        <h2>{comecar.hA}<span class="v2-em">{comecar.hEm}</span>{comecar.hB}</h2>
        <p>{comecar.p}</p>
        <a href={comecarHref} class="v2-btn v2-btn--amber v2-ss-cta">
          {comecar.cta}
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
        </a>
      </div>
      <a href={comecarHref} class="v2-ss-card" aria-label={comecar.cta}>
        <span class="v2-ss-q">{comecar.hA}{comecar.hEm}{comecar.hB}</span>
        <span class="v2-ss-opts">
          {comecar.opts.map((o, i) => (
            <span class="v2-ss-opt" data-active={i === 0 ? '' : undefined}>
              <span class="v2-ss-opt-n">{i + 1}</span>
              {o}
            </span>
          ))}
        </span>
        <span class="v2-ss-term"><span class="v2-ss-term-p">&rsaquo;</span> <span class="v2-ss-term-s">/start</span><span class="v2-ss-term-cur"></span></span>
      </a>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <Faq lang={lang} />

  <!-- ===================== DOWNLOAD / CTA final (faixa âmbar) ===================== -->
  <section class="v2band v2band--amber" id="download">
    <div class="v2wrap v2-dl-grid">
      <div class="v2-dl-art">
        <img src="/carcara.png" alt={s.download.artAlt} width="900" height="675" loading="lazy" />
      </div>
      <div class="v2-dl-card">
        <div class="v2-kicker">{s.download.kicker}</div>
        <h2 class="v2-dl-title">{s.download.title.a}<span class="v2-em">{s.download.title.em}</span>{s.download.title.b}</h2>
        <p class="v2-dl-lead">{s.download.lead}</p>

        <ul class="v2-dl-chips">
          {s.download.chips.map((chip) => <li>{chip}</li>)}
        </ul>

        <div class="v2-dl-actions">
          <a href={release.downloadUrl} data-dl-win class="v2-dl-btn">
            <PlatformIcon os="windows" width={22} height={22} fill="#F6EFE2" />
            <span>{s.download.btnWindows}</span>
            <!-- ícone de download em pixel art (sprite): seta pra baixo + bandeja -->
            <svg class="v2-dl-btn-arrow" width="18" height="18" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
              <rect x="4" y="0" width="2" height="2" /><rect x="6" y="0" width="2" height="2" />
              <rect x="4" y="2" width="2" height="2" /><rect x="6" y="2" width="2" height="2" />
              <rect x="0" y="4" width="2" height="2" /><rect x="2" y="4" width="2" height="2" /><rect x="4" y="4" width="2" height="2" /><rect x="6" y="4" width="2" height="2" /><rect x="8" y="4" width="2" height="2" /><rect x="10" y="4" width="2" height="2" />
              <rect x="2" y="6" width="2" height="2" /><rect x="4" y="6" width="2" height="2" /><rect x="6" y="6" width="2" height="2" /><rect x="8" y="6" width="2" height="2" />
              <rect x="4" y="8" width="2" height="2" /><rect x="6" y="8" width="2" height="2" />
              <rect x="0" y="10" width="2" height="2" /><rect x="2" y="10" width="2" height="2" /><rect x="4" y="10" width="2" height="2" /><rect x="6" y="10" width="2" height="2" /><rect x="8" y="10" width="2" height="2" /><rect x="10" y="10" width="2" height="2" /></svg>
          </a>
          <a href={release.macUrl} data-dl-mac class="v2-btn v2-btn--ghost v2-dl-btn-secondary">
            <PlatformIcon os="mac" width={18} height={18} fill="#6b551f" />
            Mac
          </a>
          <a href={release.linuxUrl} data-dl-linux class="v2-btn v2-btn--ghost v2-dl-btn-secondary">
            <PlatformIcon os="linux" width={18} height={18} fill="#6b551f" />
            {s.download.btnLinux}
          </a>
        </div>

        <div class="v2-dl-meta">
          <span data-dl-filename>{release.fileName}</span> · <span data-dl-meta>{release.tag} · {release.size} · {release.date}</span>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- anima o rail do mock: cicla projeto ativo + troca chat/preview com crossfade -->
  <ProjectRailScript />

  <!-- atualiza link/versão de download com a última release do GitHub (client-side) -->
  <RefreshReleaseScript />

  <!-- atualiza a contagem de estrelas com o valor atual do GitHub (client-side) -->
  <RefreshStarsScript />

  <!-- anima a contagem de estrelas do 0 até o valor real quando entra na tela -->
  <StarsCountUpScript />

  <!-- entrada do hero + reveals no scroll com GSAP (respeita movimento reduzido) -->
  <GsapAnim />
</Layout>

<style>
  /* ===== Sistema de faixas ===== */
  .v2band {
    width: 100%;
  }
  .v2band--paper {
    background: #fbf8f1;
    border-top: 1px solid #ece4d5;
    border-bottom: 1px solid #ece4d5;
  }
  .v2band--dark {
    background: #1e1913;
    color: #ede7dd;
  }
  .v2band--amber {
    background:
      radial-gradient(120% 90% at 50% -20%, rgba(255, 243, 220, 0.95) 0%, rgba(255, 243, 220, 0) 55%),
      linear-gradient(180deg, #f3d199 0%, #ecbd77 100%);
  }
  .v2wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 100px) clamp(20px, 5vw, 56px);
  }

  /* ===== Cabeçalho de seção ===== */
  .v2sh {
    text-align: center;
    max-width: 46em;
    margin-left: auto;
    margin-right: auto;
  }
