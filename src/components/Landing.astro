</style>

<script>
  // Badge do hero: efeito terminal, apaga a IA atual e digita a proxima em loop.
  function initBadgeRotator() {
    const el = document.querySelector<HTMLElement>('.v2-badge-type');
    if (!el) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const words = ['CLAUDE CODE', 'OPEN CODE', 'ANTIGRAVITY', 'GEMINI CLI', 'CODEX', 'CURSOR'];
    const TYPE = 70; // ms por caractere digitado
    const ERASE = 38; // ms por caractere apagado
    const HOLD = 1800; // pausa com a palavra completa
    const GAP = 260; // pausa apos apagar tudo, antes de digitar a proxima

    let i = 0;
    let text = words[0];
    el.textContent = text;

    function tick() {
      const next = words[i];
      if (text.length > 0 && next.slice(0, text.length) !== text) {
        // resquicio da palavra anterior: apaga um caractere
        text = text.slice(0, -1);
        el!.textContent = text;
        window.setTimeout(tick, text.length === 0 ? GAP : ERASE);
      } else if (text.length < next.length) {
        // digita o proximo caractere
        text = next.slice(0, text.length + 1);
        el!.textContent = text;
        window.setTimeout(tick, TYPE);
      } else {
        // palavra completa: segura e parte pra proxima
        i = (i + 1) % words.length;
        window.setTimeout(tick, HOLD);
      }
    }

    window.setTimeout(() => {
      i = (i + 1) % words.length;
      tick();
    }, HOLD);
  }

  document.addEventListener('DOMContentLoaded', initBadgeRotator);

  // O mock do hero nasce numa largura fixa de design (850px, ~16/9) e é escalado
  // pra caber no frame, os elementos encolhem uniformemente. Recalcula no resize.
  function fitHeroMock() {
    document.querySelectorAll<HTMLElement>('.v2-hero-visual').forEach((frame) => {
      const scaler = frame.querySelector<HTMLElement>('.v2-mock-scaler');
      if (!scaler) return;
      scaler.style.transform = `scale(${frame.clientWidth / 850})`;
    });
  }
  fitHeroMock();
  window.addEventListener('load', fitHeroMock);
  window.addEventListener('resize', fitHeroMock);

  // Carrossel: setas, dots e swipe nativo (scroll-snap). Mesma lógica da index.
  document.querySelectorAll<HTMLElement>('.cc-carousel').forEach((root) => {
    if (root.dataset.ccInit) return;
    root.dataset.ccInit = '1';

    const track = root.querySelector<HTMLElement>('[data-track]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track) return;

    const count = track.children.length;

    function current() {
      return Math.round(track!.scrollLeft / track!.clientWidth);
    }
    function go(i: number) {
      const clamped = Math.max(0, Math.min(count - 1, i));
      track!.scrollLeft = clamped * track!.clientWidth;
      sync();
    }
    function sync() {
      const i = current();
      dots.forEach((d, di) =>
        di === i ? d.setAttribute('data-active', '') : d.removeAttribute('data-active')
      );
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= count - 1;
    }

    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => window.requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', () => go(current()));
    sync();

    // Autoplay: avança sozinho a cada 5s, em loop. Pausa quando o usuário
    // passa o mouse, foca, arrasta ou quando a aba fica oculta.
    const DELAY = 5000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0;
    let paused = false;

    function stop() {
      if (timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    }
    function start() {
      stop();
      if (reduce || paused || document.hidden || count <= 1) return;
      timer = window.setInterval(() => go((current() + 1) % count), DELAY);
    }
    function pause() {
      paused = true;
      stop();
    }
    function resume() {
      paused = false;
      start();
    }

    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', resume);
    root.addEventListener('pointerdown', pause);
    root.addEventListener('touchstart', pause, { passive: true });
    document.addEventListener('visibilitychange', start);
    start();
  });
</script>
