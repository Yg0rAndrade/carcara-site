  .v2sh > .v2-steps {
    text-align: left;
  }
  .v2-kicker {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: #b07d2f;
    margin-bottom: 16px;
  }
  .v2band--dark .v2-kicker {
    color: #e7b368;
  }
  .v2band--amber .v2-kicker {
    color: #5e3f12;
  }
  .v2sh h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(30px, 4.4vw, 54px);
    line-height: 1.04;
    margin: 0 0 14px;
    color: #211c15;
  }
  .v2band--dark .v2sh h2 {
    color: #f3ede1;
  }
  .v2band--amber .v2sh h2 {
    color: #2a2410;
  }
  .v2-em {
    font-style: italic;
    color: #c5821c;
  }
  .v2band--dark .v2-em {
    color: #e7b368;
  }
  .v2band--amber .v2-em {
    color: #6b3f0a;
  }
  .v2sh p {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    color: #5c5347;
    margin: 0 auto;
  }
  .v2band--dark .v2sh p {
    color: #c3b8a5;
  }
  .v2band--amber .v2sh p {
    color: #4a3a1a;
  }
  .v2band--amber .v2sh strong {
    color: #2a2410;
    font-weight: 800;
  }

  /* ===== Botões ===== */
  .v2-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 16.5px;
    text-decoration: none;
    padding: 15px 26px;
    border-radius: 12px;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .v2-btn--amber {
    color: #211c15;
    background: #d99748;
    box-shadow: 0 4px 0 #a06f2e, 0 10px 24px rgba(160, 111, 46, 0.3);
  }
  .v2-btn--amber:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #a06f2e, 0 14px 30px rgba(160, 111, 46, 0.34);
  }
  .v2-btn--ghost {
    color: #3a342b;
    background: transparent;
    border: 1px solid #d8cfbe;
  }
  .v2-btn--ghost:hover {
    border-color: #c5821c;
  }
  .v2-btn--dark {
    color: #f3ede1;
    background: #211c15;
    box-shadow: 0 6px 18px rgba(33, 28, 21, 0.35);
  }
  .v2-btn--dark:hover {
    transform: translateY(-2px);
  }

  /* ===== Hero ===== */
  .v2-hero .v2wrap {
    padding-top: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .v2-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .v2-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'Press Start 2P', monospace;
    font-size: 9.5px;
    color: #b07d2f;
    letter-spacing: 0.05em;
    margin-bottom: 26px;
    background: #fbf8f1;
    border: 1px solid #e7e0d2;
    padding: 8px 12px;
    border-radius: 999px;
  }
  .v2-badge-static {
    white-space: nowrap;
  }
  /* efeito terminal: apaga a IA atual e digita a próxima */
  .v2-badge-rotator {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .v2-badge-type {
    white-space: pre;
  }
  .v2-badge-caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 1px;
    background: currentColor;
    animation: v2-badge-blink 1s steps(1) infinite;
  }
  @keyframes v2-badge-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-badge-caret {
      animation: none;
    }
  }
  .v2-hero-title {
    margin: 0 0 22px;
  }
  .v2-hero-l1 {
    display: block;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 5.4vw, 70px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: #211c15;
  }
  .v2-hero-l2 {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(44px, 6vw, 78px);
    line-height: 1;
    color: #c5821c;
  }
  .v2-hero-sub {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: #5c5347;
    max-width: 30em;
    margin: 0 0 32px;
  }
  /* CTA do hero empilhado: Windows em destaque, Mac/Linux como âncoras logo
     abaixo, e "todas as opções" por último. Deixa claro que a ação é baixar. */
  .v2-hero-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .v2-dl-primary {
    font-size: 17px;
  }
  /* Mac e Linux vêm logo depois, do mesmo tamanho. */
  .v2-hero-alts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .v2-dl-alt {
    padding: 14px 20px;
    font-size: 15.5px;
  }
  /* Link discreto pra página da release com todos os instaladores. */
  .v2-hero-allopts {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 2px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    color: #a06f2e;
    text-decoration: none;
    padding: 4px 2px;
    transition: gap 0.16s ease, color 0.16s ease;
  }
  .v2-hero-allopts:hover {
    color: #7c5518;
    gap: 10px;
  }
  @media (max-width: 460px) {
    .v2-hero-cta {
      align-items: stretch;
    }
    .v2-dl-primary {
      justify-content: center;
    }
    .v2-hero-alts {
      width: 100%;
    }
    .v2-dl-alt {
      flex: 1;
      justify-content: center;
    }
    .v2-hero-allopts {
      justify-content: center;
    }
  }
  .v2-hero-meta {
    display: block;
    margin-top: 15px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #8a8073;
    letter-spacing: 0.02em;
  }
  /* Frame 16/9: o mock é renderizado numa largura fixa "de design" (850px, onde
     já nasce confortável e ~16/9) e ESCALADO por JS pra caber no frame. Assim os
     elementos encolhem TODOS juntos, em vez de ficarem grandes num quadro
     apertado. */
  .v2-hero-visual {
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 28px 60px -20px rgba(110, 80, 30, 0.45),
      0 10px 22px -12px rgba(110, 80, 30, 0.22);
  }
  .v2-mock-scaler {
    width: 850px;
    transform-origin: top left;
    will-change: transform;
  }
  .v2-mock-scaler > :global(div) {
    box-shadow: none;
    border-radius: 16px;
  }

