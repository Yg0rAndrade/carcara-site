// ============================================================================
// Landing principal (corpo compartilhado pt/en). As páginas src/pages/index.astro
// (pt, raiz) e src/pages/en/index.astro (en) só renderizam <Landing lang=.../>.
// Todo o texto vem do dicionário i18n (src/i18n/strings.ts). Mantém o tema
// creme + brasa. Regra do projeto: sem travessão (—) em nenhum texto.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import IdeWindow from './IdeWindow.astro';
import Seletor from './Seletor.astro';
import Demo from './Demo.astro';
import Faq from './Faq.astro';
import CarcaraLogo from './CarcaraLogo.astro';
import PlatformIcon from './PlatformIcon.astro';
import ProjectRailScript from './ProjectRailScript.astro';
import RefreshReleaseScript from './RefreshReleaseScript.astro';
import RefreshStarsScript from './RefreshStarsScript.astro';
import StarsCountUpScript from './StarsCountUpScript.astro';
import GsapAnim from './GsapAnim.astro';
import { Image } from 'astro:assets';
import { release } from '../data/release';
import { REPO_URL, stars, formatStars } from '../data/repo';
import { projects, letterOf, tx } from '../data/projects';
import { useStrings, type Lang } from '../i18n/strings';
import stackIcons from '../data/stackIcons.json';

// Logos oficiais (paths do simple-icons) por tecnologia, usados nos chips de stack.
const STACK_ICONS = stackIcons as Record<string, { hex: string; path: string }>;

import aiPerProject from '../assets/shots/ai-per-project.png';
import codeShot from '../assets/shots/code.png';
import previewSite from '../assets/shots/preview-site.png';
import previewLogin from '../assets/shots/preview-login.png';
import avatarRony from '../assets/avatars/rony-simao.webp';
import avatarManoel from '../assets/avatars/manoel-neto.webp';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const s = useStrings(lang);

// Chamada para a página dedicada "Como começar um projeto" (a skill start). A
// página só existe em pt e en; os outros idiomas caem na versão em inglês. Texto
// inline (pt fonte, en fallback), sem inchar o strings.ts dos 18 idiomas.
const comecarHref = lang === 'pt' ? '/comecar/' : '/en/comecar/';

// Link "todas as opções de download": leva à página de download dedicada
// (/baixar/), com todos os instaladores. Inline pt/en, resto cai no en, mesmo
// padrão do bloco comecar acima.
const allOptionsLabel = lang === 'pt' ? 'Todas as opções' : 'All download options';
const baixarHref = lang === 'pt' ? '/baixar/' : '/en/baixar/';
const comecar =
  lang === 'pt'
    ? {
        kicker: 'COMEÇAR UM PROJETO DO ZERO',
        hA: 'Não sabe ',
        hEm: 'qual tecnologia',
        hB: ' usar?',
        p: 'A skill start faz até 3 perguntas simples e monta seu projeto pronto, com a stack certa já configurada. Você descreve o que quer, ela decide o resto. Sem escolher framework na mão.',
        opts: ['Página de vendas', 'Sistema com login', 'Loja no Google'],
        cta: 'Ver como começar um projeto',
      }
    : {
        kicker: 'START A PROJECT FROM SCRATCH',
        hA: "Don't know ",
        hEm: 'which tech',
        hB: ' to use?',
        p: 'The start skill asks up to 3 simple questions and scaffolds your project with the right stack already set up. You describe what you want, it decides the rest. No picking a framework by hand.',
        opts: ['Sales page', 'App with login', 'Store on Google'],
        cta: 'See how to start a project',
      };

// Avaliações. Chrome da seção inline (pt fonte, en fallback), mesmo padrão do
// bloco comecar acima, pra não inchar o strings.ts dos 18 idiomas. Os
// depoimentos em si são reais: o texto de cada pessoa fica no idioma original
// (pt) com tradução pro en; nos outros idiomas cai no en.
const avaliacoes =
  lang === 'pt'
    ? {
        kicker: 'DEPOIMENTOS',
        hA: 'Quem já ',
        hEm: 'soltou o carcará',
        hB: '.',
        p: 'Gente de verdade, em projeto de produção, contando como é na prática.',
      }
    : {
        kicker: 'TESTIMONIALS',
        hA: 'People who ',
        hEm: 'let the bird loose',
        hB: '.',
        p: 'Real people, on production projects, telling how it actually feels.',
      };

const depoimentos = [
  {
    nome: 'Rony Simão',
    foto: avatarRony,
    cor: '#c5821c',
    texto:
      lang === 'pt'
        ? 'O Carcará Code foi um divisor de águas pra mim. Comecei usando em projeto pessoal, aí quando vi que o gigante Antigravity caía todo dia, resolvi dar uma chance, melhor coisa que fiz. Uso hoje pra tudo: produção, projetos pessoais, etc. Ele NUNCA caiu, funciona liso, estou até modificando ele pra ficar mais do meu jeito e ele continua intacto. Que projeto!!!'
        : 'Carcará Code was a turning point for me. I started using it on a side project, and when I saw the giant Antigravity going down every day, I gave it a shot, best thing I did. I use it for everything now: production, side projects, all of it. It has NEVER crashed, runs smooth, I am even tweaking it to fit my own taste and it stays rock solid. What a project!!!',
  },
  {
    nome: 'Manoel Neto',
    foto: avatarManoel,
    cor: '#5ba86b',
    texto:
      lang === 'pt'
        ? 'O Carcará Code virou a minha IDE favorita. Troco entre vários projetos numa velocidade absurda e ainda uso qualquer IA em cada um deles ao mesmo tempo. Assino o Claude e o Codex, coloco cada um numa aba, cada um numa tarefa diferente, e acompanho os dois trabalhando em tempo real. Essa praticidade muda o dia a dia. E pra mim é uma honra ser um dos contribuidores do projeto.'
        : 'Carcará Code became my favorite IDE. I switch between projects at an absurd speed and still run any AI in each one at the same time. I subscribe to Claude and Codex, put each in its own tab on a different task, and watch both working in real time. That convenience changes your day to day. And for me it is an honor to be one of the project contributors.',
  },
];

