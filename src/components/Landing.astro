  .v2-trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 40px);
    text-align: center;
  }
  .v2-trust-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
  }
  .v2-trust-big {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(18px, 2vw, 23px);
    color: #f3ede1;
  }
  .v2-trust-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: #9a8f7c;
    letter-spacing: 0.02em;
  }
  .v2-trust-link:hover .v2-trust-big {
    color: #e7b368;
  }
  .v2-trust-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #6f6555;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }
  .v2-trust-link:hover .v2-trust-hint {
    color: #e7b368;
  }
  .v2-trust-div {
    width: 1px;
    height: 34px;
    background: rgba(237, 231, 221, 0.16);
  }

  /* ===== Grade de recursos ===== */
  .v2-grid {
    margin-top: clamp(32px, 4vw, 52px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .v2-card {
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 16px;
    padding: clamp(22px, 2.6vw, 30px);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .v2-card:hover {
    transform: translateY(-3px);
    border-color: #e2cfa8;
    box-shadow: 0 14px 34px rgba(160, 111, 46, 0.12);
  }
  .v2-card-ic {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: #fbf1df;
    color: #c5821c;
    margin-bottom: 16px;
  }
  .v2-card h3 {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 18.5px;
    margin: 0 0 7px;
    color: #211c15;
  }
  .v2-card p {
    font-size: 15px;
    line-height: 1.55;
    color: #5c5347;
    margin: 0;
  }

  /* ===== Comparativo ===== */
  .v2-cmp {
    margin-top: clamp(32px, 4vw, 52px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .v2-cmp-col {
    border-radius: 16px;
    padding: clamp(22px, 2.6vw, 30px);
  }
  .v2-cmp-before {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(237, 231, 221, 0.1);
  }
  .v2-cmp-after {
    background: rgba(217, 151, 72, 0.1);
    border: 1px solid rgba(217, 151, 72, 0.34);
  }
  .v2-cmp-head {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.05em;
    margin-bottom: 18px;
  }
  .v2-cmp-before .v2-cmp-head {
    color: #8a8073;
  }
  .v2-cmp-after .v2-cmp-head {
    color: #e7b368;
  }
  .v2-cmp-row {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 11px 0;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15.5px;
    line-height: 1.45;
    border-top: 1px solid rgba(237, 231, 221, 0.08);
  }
  .v2-cmp-before .v2-cmp-row {
    color: #b0a795;
  }
  .v2-cmp-after .v2-cmp-row {
    color: #ede7dd;
  }
  .v2-cmp-mark {
    flex: none;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin-top: 1px;
  }
  .v2-cmp-mark--x {
    background: rgba(237, 231, 221, 0.08);
    color: #8a8073;
  }
  .v2-cmp-mark--check {
    background: #d99748;
    color: #211c15;
  }

  /* ===== Avaliações / depoimentos ===== */
  .v2-reviews {
    margin: clamp(32px, 4vw, 52px) auto 0;
    max-width: 720px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }
  .v2-review {
    margin: 0;
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 16px;
    padding: clamp(24px, 3vw, 34px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .v2-review:hover {
    transform: translateY(-3px);
    border-color: #e2cfa8;
    box-shadow: 0 14px 34px rgba(160, 111, 46, 0.12);
  }
  .v2-review-stars {
    display: inline-flex;
    gap: 3px;
    color: #d99748;
  }
  .v2-review-text {
    margin: 0;
    font-family: 'Instrument Serif', serif;
    font-size: clamp(19px, 2.1vw, 24px);
    line-height: 1.42;
    color: #2c261d;
  }
  .v2-review-who {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 2px;
  }
  .v2-review-av {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px var(--c, #e2cfa8);
  }
  .v2-review-name {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 15.5px;
    color: #211c15;
  }

  /* ===== Carrossel de IAs (seção da assinatura) ===== */
  .v2-ai-label {
    margin: clamp(30px, 4vw, 46px) 0 18px;
    text-align: center;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: #6b3f0a;
  }
  /* Marquee: os chips deslizam em loop; as bordas somem com uma máscara. O
     overflow corta só na horizontal; o padding vertical dá espaço pro "bob" e
     pra sombra dos chips não serem cortados no topo/base. */
  .v2-ai-mq {
    overflow: hidden;
    padding: 22px 0 30px;
    -webkit-mask: linear-gradient(90deg, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask: linear-gradient(90deg, transparent 0, #000 10%, #000 90%, transparent 100%);
  }
  .v2-ai-track {
    display: flex;
    align-items: center;
    gap: 16px;
    width: max-content;
    animation: v2AiScroll 26s linear infinite;
  }
  .v2-ai-mq:hover .v2-ai-track {
    animation-play-state: paused;
  }
  @keyframes v2AiScroll {
    to {
      transform: translateX(-50%);
    }
  }
  /* Chip: pílula branca com o logo (tinta) + nome, flutuando de leve. */
  .v2-ai-chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #fffdf8;
    border: 1px solid rgba(107, 63, 10, 0.16);
    border-radius: 999px;
    padding: 13px 22px 13px 16px;
    box-shadow: 0 10px 24px -12px rgba(107, 63, 10, 0.45);
    animation: v2AiBob 3.6s ease-in-out infinite;
  }
  .v2-ai-chip:nth-child(2n) {
    animation-delay: -0.9s;
  }
  .v2-ai-chip:nth-child(3n) {
    animation-delay: -1.8s;
  }
  .v2-ai-chip:nth-child(4n) {
    animation-delay: -2.7s;
  }
  @keyframes v2AiBob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }
  .v2-ai-ic {
    flex: none;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    color: #241d13;
  }
  .v2-ai-ic :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .v2-ai-name {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 15.5px;
    color: #241d13;
    white-space: nowrap;
  }
  /* Movimento reduzido: nada desliza nem flutua; os chips viram uma linha estática
     e centralizada, e o conjunto duplicado some. */
  @media (prefers-reduced-motion: reduce) {
    .v2-ai-mq {
      -webkit-mask: none;
      mask: none;
    }
    .v2-ai-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .v2-ai-chip {
      animation: none;
    }
    .v2-ai-chip[data-dup] {
      display: none;
    }
  }

  /* ===== Multiplexador ===== */
  .v2-mux {
    margin-top: clamp(32px, 4vw, 52px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .v2-mux-card {
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .v2-mux-card[data-active] {
    border-color: #e2cfa8;
    box-shadow: 0 16px 36px -16px var(--c);
    transform: translateY(-4px);
  }
  .v2-mux-top {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .v2-mux-ic {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 13px;
    color: #fff;
    background: var(--c);
  }
  .v2-mux-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: #211c15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .v2-mux-live {
    margin-left: auto;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #5ba86b;
  }
  .v2-mux-live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5ba86b;
    box-shadow: 0 0 0 3px rgba(91, 168, 107, 0.18);
  }
  .v2-mux-chat {
    background: #fbf8f1;
    border: 1px solid #efe8da;
    border-radius: 10px;
    padding: 10px 12px;
    min-height: 62px;
  }
  .v2-mux-msg {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12.5px;
    line-height: 1.45;
    color: #5c5347;
  }
  .v2-mux-foot {
    display: flex;
    gap: 8px;
  }
  .v2-mux-foot span {
    flex: 1;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a8073;
    background: #faf6ee;
    border: 1px solid #efe8da;
    border-radius: 7px;
    padding: 6px 4px;
  }

  /* ===== Qualquer stack (nuvem de chips) ===== */
  .v2-stacks {
    margin: clamp(32px, 4vw, 52px) auto 0;
    max-width: 860px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .v2-stack-chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15.5px;
    color: #3a342b;
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 999px;
    padding: 10px 18px;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .v2-stack-chip:hover {
    transform: translateY(-2px);
    border-color: #e2cfa8;
    box-shadow: 0 10px 24px rgba(160, 111, 46, 0.12);
  }
  .v2-stack-ic {
    flex: none;
    width: 18px;
    height: 18px;
    display: block;
  }
  .v2-stack-chip--more {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    font-size: 13px;
    font-style: italic;
    color: #8a8073;
    background: transparent;
    border-style: dashed;
    border-color: #d8cfbe;
  }
  .v2-stack-chip--more:hover {
    box-shadow: none;
    border-color: #c5821c;
  }

  /* ===== Como começar (timeline vertical) ===== */
  .v2-tl {
    list-style: none;
    margin: clamp(32px, 4vw, 48px) auto 0;
    padding: 0;
    max-width: 620px;
  }
  .v2-tl-step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 18px;
  }
  .v2-tl-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .v2-tl-dot {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 16px;
    color: #fff;
    background: #d99748;
    box-shadow: 0 0 0 5px rgba(217, 151, 72, 0.16);
  }
  .v2-tl-dot--done {
    background: #5ba86b;
    box-shadow: 0 0 0 5px rgba(91, 168, 107, 0.16);
  }
  .v2-tl-line {
    flex: 1;
    width: 2px;
    margin: 6px 0;
    background: linear-gradient(to bottom, rgba(217, 151, 72, 0.7), #e7e0d2);
    border-radius: 2px;
  }
  .v2-tl-body {
    min-width: 0;
    padding-bottom: clamp(28px, 4vw, 40px);
  }
  .v2-tl-step--done .v2-tl-body {
    padding-bottom: 0;
  }
  .v2-tl-body h3 {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 18px;
    margin: 7px 0 6px;
    color: #211c15;
  }
  .v2-tl-body > p {
    font-size: 15px;
    line-height: 1.55;
    color: #5c5347;
    margin: 0;
  }
  .v2-tl-mock {
    margin-top: 16px;
  }
  /* mini terminal (passo 1) */
  .v2-tl-term {
    background: #1c1811;
    border: 1px solid #2c261c;
    border-radius: 12px;
    padding: 12px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    line-height: 1.85;
    color: #d8cdb8;
    overflow-x: auto;
  }
  .v2-tl-term-bar {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }
  .v2-tl-term-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #4a4235;
  }
  .v2-tl-term code {
    display: block;
    white-space: nowrap;
  }
  .v2-tl-prompt {
    color: #d99748;
    margin-right: 7px;
  }
  .v2-tl-ok {
    color: #7bbf87;
  }
  /* mini card de download (passo 2) */
  .v2-tl-dlcard {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 12px;
    padding: 12px 14px;
  }
  .v2-tl-dl-ic {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: #fbf1df;
    display: grid;
    place-items: center;
  }
  .v2-tl-dl-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .v2-tl-dl-txt strong {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 13.5px;
    color: #211c15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .v2-tl-dl-txt span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #8a8073;
  }
  .v2-tl-dl-badge {
    margin-left: auto;
    flex: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    color: #b07d2f;
    background: #fbf1df;
    border: 1px solid #e7cfa4;
    border-radius: 6px;
    padding: 3px 8px;
  }
  /* mini rail de projetos (passo 3) */
  .v2-tl-rail-mock {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    border: 1px solid #ece4d5;
    border-radius: 12px;
    padding: 12px 14px;
    flex-wrap: wrap;
  }
  .v2-tl-proj {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 14px;
    color: var(--c);
    background: #fff;
    border: 1.5px solid #e7e0d2;
    /* alternância do ícone ativo: cada ícone acende na sua vez (delay por índice,
       5 ícones num ciclo de 5s), imitando o rail do hero trocando de projeto. */
    animation: ccRailHop 5s ease-in-out infinite;
  }
  .v2-tl-proj[data-active] {
    color: #fff;
    background: var(--c);
    border-color: var(--c);
    box-shadow: 0 4px 12px -3px var(--c);
  }
  @keyframes ccRailHop {
    0%, 100% {
      color: var(--c);
      background: #fff;
      border-color: #e7e0d2;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transform: scale(1);
    }
    8%, 16% {
      color: #fff;
      background: var(--c);
      border-color: var(--c);
      box-shadow: 0 5px 13px -3px var(--c);
      transform: scale(1.08);
    }
    24% {
      color: var(--c);
      background: #fff;
      border-color: #e7e0d2;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-tl-proj {
      animation: none;
    }
  }
  .v2-tl-proj-add {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-size: 18px;
    color: #b3a78f;
    border: 1.5px dashed #d8cfbe;
  }

  /* ===== Skill start (chamada p/ /comecar) ===== */
  .v2-ss {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .v2-ss-txt .v2-kicker {
    color: #e7b368;
  }
  .v2-ss-txt h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.04;
    margin: 0 0 14px;
    color: #f3ede1;
  }
  .v2-ss-txt .v2-em {
    color: #e7b368;
  }
  .v2-ss-txt > p {
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.55;
    color: #c3b8a5;
    margin: 0 0 26px;
    max-width: 34em;
  }
  .v2-ss-cta {
    text-decoration: none;
  }
  /* card teaser: imita os "quadradinhos" da página dedicada */
  .v2-ss-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    background: linear-gradient(180deg, #221c14 0%, #191410 100%);
    border: 1px solid #35291b;
    border-radius: 18px;
    padding: clamp(22px, 2.6vw, 30px);
    box-shadow: 0 22px 46px -18px rgba(0, 0, 0, 0.5);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .v2-ss-card:hover {
    transform: translateY(-3px);
    border-color: #6b4f2a;
    box-shadow: 0 26px 54px -18px rgba(120, 78, 20, 0.5);
  }
  .v2-ss-q {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: 17px;
    color: #f6d9a6;
    margin-bottom: 4px;
  }
  .v2-ss-opts {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .v2-ss-opt {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 14.5px;
    color: #d8cdb8;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(237, 231, 221, 0.1);
    border-radius: 11px;
    padding: 11px 14px;
  }
  .v2-ss-opt[data-active] {
    color: #f3ede1;
    background: rgba(217, 151, 72, 0.12);
    border-color: rgba(217, 151, 72, 0.42);
  }
  .v2-ss-opt-n {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 13px;
    color: #b07d2f;
    background: rgba(217, 151, 72, 0.14);
  }
  .v2-ss-opt[data-active] .v2-ss-opt-n {
    color: #211c15;
    background: #d99748;
  }
  .v2-ss-term {
    margin-top: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: #e6dcc7;
    background: #0c0a07;
    border: 1px solid #2c2418;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .v2-ss-term-p {
    color: #d99748;
    font-weight: 700;
    margin-right: 6px;
  }
