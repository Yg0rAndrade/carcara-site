---
import CarcaraLogo from './CarcaraLogo.astro';
import { useStrings, LOCALES, type Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const s = useStrings(lang);

// Seletor de idioma: aponta para o idioma OPOSTO. A escolha é persistida no
// clique (data-lang-switch), para a detecção automática não desfazer a troca.
const other: Lang = lang === 'en' ? 'pt' : 'en';
const otherUrl = LOCALES[other].path;
const otherShort = LOCALES[other].short;
const otherLabel = LOCALES[other].label;
---

<!-- NAV -->
<nav
  class="cc-nav"
  style="position:sticky; top:0; z-index:100; display:flex; align-items:center; justify-content:space-between; padding:15px clamp(20px,5vw,56px); border-bottom:1px solid rgba(110,90,55,0.18); background:rgba(237,231,221,0.82); backdrop-filter:blur(10px);"
>
  <div style="display:flex; align-items:center; gap:11px;">
    <CarcaraLogo width={24} height={24} />
    <span
      style="font-family:'Press Start 2P',monospace; font-size:clamp(10px,2.6vw,12px); color:#211C15; letter-spacing:0.01em; white-space:nowrap;"
      >CARCARÁ&nbsp;CODE</span
    >
  </div>
  <div style="display:flex; align-items:center; gap:26px;">
    <a
      href="#recursos"
      class="cc-nav-link"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none; letter-spacing:0.04em; text-transform:uppercase;"
      >{s.nav.features}</a
    >
    <a
      href="#ide"
      class="cc-nav-link"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none; letter-spacing:0.04em; text-transform:uppercase;"
      >{s.nav.ide}</a
    >
    <a
      href={otherUrl}
      class="cc-lang-switch"
      data-lang-switch={other}
      title={otherLabel}
      aria-label={otherLabel}
      style="display:inline-flex; align-items:center; gap:6px; font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:700; color:#6A6053; text-decoration:none; letter-spacing:0.04em; border:1px solid rgba(110,90,55,0.28); padding:6px 10px; border-radius:8px;"
    >
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg>
      {otherShort}
    </a>
    <a
      href="#download"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:700; color:#211C15; background:#D99748; text-decoration:none; padding:9px 16px; border-radius:8px; letter-spacing:0.03em; text-transform:uppercase; box-shadow:0 2px 0 #a06f2e;"
      >{s.nav.download}</a
    >
  </div>
</nav>

<style>
  .cc-lang-switch:hover {
    border-color: #c5821c !important;
    color: #211c15 !important;
  }
</style>
