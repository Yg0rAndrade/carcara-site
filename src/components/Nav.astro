---
import CarcaraLogo from './CarcaraLogo.astro';
import { useStrings, LOCALES, LANGS, type Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'pt' } = Astro.props;
const s = useStrings(lang);
const loc = LOCALES[lang];
---

<!-- NAV -->
<nav
  class="cc-nav"
  style="position:sticky; top:0; z-index:100; display:flex; align-items:center; justify-content:space-between; padding:15px clamp(20px,5vw,56px); border-bottom:1px solid rgba(110,90,55,0.18); background:rgba(237,231,221,0.82); backdrop-filter:blur(10px);"
>
  <div style="display:flex; align-items:center; gap:11px;">
    <CarcaraLogo
      width={24}
      height={24}
      class="cc-logo-egg"
      style="cursor:pointer; transform-origin:center bottom; will-change:transform; -webkit-user-select:none; user-select:none;"
    />
    <span
      style="font-family:'Press Start 2P',monospace; font-size:clamp(10px,2.6vw,12px); color:#211C15; letter-spacing:0.01em; white-space:nowrap;"
      >CARCARÁ&nbsp;CODE</span
    >
    <audio class="cc-logo-egg-audio" src="/canto-carcara.m4a" preload="none"></audio>
  </div>
  <div style="display:flex; align-items:center; gap:26px;">
    <a
      href="#recursos"
      class="cc-nav-link"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none; letter-spacing:0.04em; text-transform:uppercase;"
      >{s.nav.features}</a
    >
    <a
      href="#ide"
      class="cc-nav-link"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#6A6053; text-decoration:none; letter-spacing:0.04em; text-transform:uppercase;"
      >{s.nav.ide}</a
    >
    <details class="cc-lang">
      <summary class="cc-lang-btn" aria-label="Idioma / Language">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg>
        <span>{loc.short}</span>
        <svg class="cc-lang-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="cc-lang-menu" role="menu">
        {LANGS.map((l) => (
          <a
            href={LOCALES[l].path}
            class={`cc-lang-item cc-lang-switch${l === lang ? ' is-current' : ''}`}
            data-lang-switch={l}
            hreflang={LOCALES[l].hreflang}
            lang={LOCALES[l].htmlLang}
            aria-current={l === lang ? 'true' : undefined}
          >
            <span class="cc-lang-code">{LOCALES[l].short}</span>
            <span class="cc-lang-name">{LOCALES[l].label}</span>
          </a>
        ))}
      </div>
    </details>
    <a
      href="#download"
      style="font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:700; color:#211C15; background:#D99748; text-decoration:none; padding:9px 16px; border-radius:8px; letter-spacing:0.03em; text-transform:uppercase; box-shadow:0 2px 0 #a06f2e;"
      >{s.nav.download}</a
    >
  </div>
</nav>

<style>
  /* ===== Seletor de idioma (dropdown com <details>, sem JS) ===== */
  .cc-lang {
    position: relative;
  }
  .cc-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    color: #6a6053;
    letter-spacing: 0.04em;
    border: 1px solid rgba(110, 90, 55, 0.28);
    padding: 6px 10px;
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .cc-lang-btn::-webkit-details-marker {
    display: none;
  }
  .cc-lang-btn:hover {
    border-color: #c5821c;
    color: #211c15;
  }
  .cc-lang-caret {
    transition: transform 0.18s ease;
  }
  .cc-lang[open] .cc-lang-caret {
    transform: rotate(180deg);
  }
  .cc-lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 200;
    width: 210px;
    max-height: min(64vh, 420px);
    overflow-y: auto;
    padding: 6px;
    background: #fbf8f1;
    border: 1px solid #e7e0d2;
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(110, 80, 30, 0.22);
    display: grid;
    gap: 2px;
  }
  .cc-lang-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: #3a342b;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14px;
  }
  .cc-lang-item:hover {
    background: #f1e9d9;
  }
  .cc-lang-item.is-current {
    background: #f3e2c3;
  }
  .cc-lang-code {
    flex: none;
    width: 30px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    color: #b07d2f;
    letter-spacing: 0.03em;
  }
  .cc-lang-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  // Fecha o dropdown de idioma ao clicar fora ou apertar Esc.
  document.querySelectorAll<HTMLDetailsElement>('.cc-lang').forEach((d) => {
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') d.open = false;
    });
  });

  // Easter egg: duplo-clique na logo toca o canto do carcará (10s)
  // e a logo dá pulinhos conforme o volume do áudio (Web Audio API).
  const logo = document.querySelector<SVGSVGElement>('.cc-logo-egg');
  const audio = document.querySelector<HTMLAudioElement>('.cc-logo-egg-audio');
  if (logo && audio) {
    let ctx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let data: Uint8Array | null = null;
    let raf = 0;

    const rest = () => {
      logo.style.transform = 'translateY(0) scale(1)';
    };

    const tick = () => {
      if (!analyser || !data) return;
      analyser.getByteTimeDomainData(data);
      // RMS do sinal (0..~0.5) -> nível de "energia" do canto
      let sum = 0;
      for (let i = 0; i < data.length; i++) {
        const v = (data[i] - 128) / 128;
        sum += v * v;
      }
      const level = Math.min(1, Math.sqrt(sum / data.length) * 3.2);
      const lift = level * 14; // pulinho em px
      const squash = 1 + level * 0.18; // esticadinha
      logo.style.transform = `translateY(${-lift}px) scale(${2 - squash}, ${squash})`;
      raf = requestAnimationFrame(tick);
    };

    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      logo.style.transition = 'transform 0.25s cubic-bezier(0.34,1.56,0.64,1)';
      rest();
      setTimeout(() => {
        logo.style.transition = '';
      }, 260);
    };

    logo.addEventListener('dblclick', async (e) => {
      e.preventDefault();
      try {
        if (!ctx) {
          ctx = new (window.AudioContext ||
            (window as unknown as { webkitAudioContext: typeof AudioContext })
              .webkitAudioContext)();
          const src = ctx.createMediaElementSource(audio);
          analyser = ctx.createAnalyser();
          analyser.fftSize = 256;
          data = new Uint8Array(analyser.fftSize);
          src.connect(analyser);
          analyser.connect(ctx.destination);
        }
        if (ctx.state === 'suspended') await ctx.resume();
        logo.style.transition = '';
        audio.currentTime = 0;
        await audio.play();
        if (!raf) tick();
      } catch {
        // Navegador sem suporte a Web Audio: só toca o áudio.
        try {
          audio.currentTime = 0;
          await audio.play();
        } catch {
          /* ignore */
        }
      }
    });

    audio.addEventListener('ended', stop);
    audio.addEventListener('pause', stop);
  }
</script>
