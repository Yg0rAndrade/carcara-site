---
// Ao carregar a página, busca a última release no GitHub e atualiza o link de
// download, a versão e os metadados. É progressive enhancement: se a API falhar
// (offline, rate limit), ficam valendo os valores embutidos no build.
---

<script>
  import { LATEST_API, parseRelease } from '../data/release';

  async function refresh() {
    try {
      const res = await fetch(LATEST_API, {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!res.ok) return;
      const info = parseRelease(await res.json());
      if (!info) return;

      document
        .querySelectorAll<HTMLAnchorElement>('[data-dl-win]')
        .forEach((el) => (el.href = info.downloadUrl));
      document
        .querySelectorAll<HTMLAnchorElement>('[data-dl-mac]')
        .forEach((el) => (el.href = info.macUrl));
      document
        .querySelectorAll<HTMLAnchorElement>('[data-dl-mac-intel]')
        .forEach((el) => (el.href = info.macIntelUrl));
      document
        .querySelectorAll<HTMLAnchorElement>('[data-dl-linux]')
        .forEach((el) => (el.href = info.linuxUrl));

      // Tamanhos por plataforma (página de download). Só atualiza se veio valor.
      const sizes: [string, string][] = [
        ['[data-dl-win-size]', info.size],
        ['[data-dl-mac-size]', info.macSize],
        ['[data-dl-mac-intel-size]', info.macIntelSize],
        ['[data-dl-linux-size]', info.linuxSize],
      ];
      sizes.forEach(([sel, val]) => {
        if (!val) return;
        document
          .querySelectorAll<HTMLElement>(sel)
          .forEach((el) => (el.textContent = val));
      });

      document
        .querySelectorAll<HTMLElement>('[data-dl-filename]')
        .forEach((el) => (el.textContent = info.fileName));
      document
        .querySelectorAll<HTMLElement>('[data-dl-version]')
        .forEach((el) => (el.textContent = info.tag));
      document
        .querySelectorAll<HTMLElement>('[data-dl-meta]')
        .forEach(
          (el) =>
            (el.textContent = `${info.tag} · ${info.size} · ${info.date}`)
        );
    } catch {
      /* mantém os valores do build */
    }
  }

  refresh();
</script>
