---
// Atualiza a contagem de estrelas do GitHub no cliente (progressive
// enhancement). Se a API falhar, ficam valendo os valores do build. Só mostra o
// número quando >= STAR_MIN, abaixo disso, esconde o span (sinal fraco).
---

<script>
  import { REPO_API, STAR_MIN, formatStars } from '../data/repo';

  async function refresh() {
    try {
      const res = await fetch(REPO_API, {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!res.ok) return;
      const data = await res.json();
      const n = data?.stargazers_count;
      if (typeof n !== 'number') return;

      document
        .querySelectorAll<HTMLElement>('[data-gh-stars]')
        .forEach((el) => {
          // Prefixo por elemento: SocialProof usa "· 17", o badge do hero usa
          // só "17". Default mantém o comportamento antigo ("· ").
          const prefix = el.dataset.ghStarsPrefix ?? '· ';
          if (n >= STAR_MIN) {
            if ('ghStarsCountup' in el.dataset) {
              // quem escreve nesse elemento é o contador animado
              // (StarsCountUpScript); avisa o valor real e deixa ele contar
              el.dispatchEvent(new CustomEvent('gh-stars:value', { detail: n }));
            } else {
              el.textContent = prefix + formatStars(n);
            }
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
    } catch {
      /* mantém os valores do build */
    }
  }

  refresh();
</script>
