      opacity: 1;
    }
  }
</style>

<script>
  // A janela nasce numa largura fixa (720px) e é escalada pra caber no palco,
  // assim tudo encolhe junto em telas menores. Recalcula no load e no resize.
  function fitSelMock() {
    document.querySelectorAll<HTMLElement>('.cc-sel-stage').forEach((stage) => {
      const scaler = stage.querySelector<HTMLElement>('.cc-sel-scaler');
      if (!scaler) return;
      scaler.style.transform = `scale(${stage.clientWidth / 720})`;
    });
  }
  fitSelMock();
  window.addEventListener('load', fitSelMock);
  window.addEventListener('resize', fitSelMock);
</script>
