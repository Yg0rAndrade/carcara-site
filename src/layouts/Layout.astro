---
import { release } from '../data/release';
import { useStrings, LOCALES, LANGS, type Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** quando true, emite <meta name="robots" content="noindex"> (ex.: página legada) */
  noindex?: boolean;
  /**
   * Alternates de idioma desta página (mapa lang -> caminho). Só necessário em
   * subpáginas que existem em poucos idiomas (ex.: /comecar/ em pt e en). Quando
   * ausente, cai no padrão (home de cada idioma).
   */
  pageAlternates?: Partial<Record<Lang, string>>;
}

const { lang = 'pt', title, description, noindex = false, pageAlternates } = Astro.props;
const s = useStrings(lang);
const loc = LOCALES[lang];
const others = LANGS.filter((l) => l !== lang);

const pageTitle = title ?? s.meta.title;
const pageDesc = description ?? s.meta.description;

// URLs absolutas para canonical e Open Graph (dependem do `site` no astro.config).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);

// Alternates de idioma (hreflang): uma entrada por idioma + x-default (pt).
// Em subpáginas (pageAlternates), usa os caminhos daquela página; senão, as homes.
const altSource: { l: Lang; path: string }[] = pageAlternates
  ? (Object.keys(pageAlternates) as Lang[]).map((l) => ({ l, path: pageAlternates[l]! }))
  : LANGS.map((l) => ({ l, path: LOCALES[l].path }));
const alternates = altSource.map(({ l, path }) => ({
  hreflang: LOCALES[l].hreflang,
  href: new URL(path, Astro.site).href,
}));
const xDefault = new URL(pageAlternates?.pt ?? LOCALES.pt.path, Astro.site).href;

const priceCurrency = lang === 'pt' ? 'BRL' : 'USD';

// Detecção de idioma (script inline abaixo). Serializa a lista de locales
// (código + caminho) pro script decidir redirecionamentos no cliente.
const detectLocales = JSON.stringify(LANGS.map((l) => ({ code: l, path: LOCALES[l].path })));
const detectionScript = `(function(){try{
var locales=${detectLocales};
function norm(p){return p.replace(/\\/$/,'')||'/';}
var here=norm(location.pathname);
var cur=null;for(var i=0;i<locales.length;i++){if(norm(locales[i].path)===here){cur=locales[i];break;}}
if(!cur)return;
function pathOf(code){for(var i=0;i<locales.length;i++){if(locales[i].code===code)return locales[i].path;}return null;}
var pref=null;try{pref=localStorage.getItem('cc-lang');}catch(e){}
if(pref){var pp=pathOf(pref);if(pp&&norm(pp)!==here){location.replace(pp);}return;}
if(cur.code!=='pt')return;
var ua=navigator.userAgent||'';
if(/bot|crawl|spider|slurp|bing|google|yandex|duckduck|baidu|facebookexternalhit|embedly|whatsapp|telegram/i.test(ua))return;
var nav=(navigator.language||(navigator.languages&&navigator.languages[0])||'').toLowerCase();
if(!nav)return;
var code=nav.indexOf('zh')===0?'zh':nav.slice(0,2);
var target=pathOf(code);
if(target&&code!=='pt'){location.replace(target);}
}catch(e){}})();`;

// Resolve o tema antes da primeira pintura para evitar troca visual. O padrão é
// claro; o escuro só entra quando o visitante o escolheu anteriormente.
const themeScript = `(function(){try{
var saved=localStorage.getItem('cc-theme');
var dark=saved==='dark';
var theme=dark?'dark':'light';
document.documentElement.dataset.theme=theme;
document.documentElement.style.colorScheme=theme;
}catch(e){document.documentElement.dataset.theme='light';}})();`;

// Structured data (schema.org), ajuda o Google e as buscas por IA a entenderem
// que isto é um app grátis, de código aberto e multiplataforma. Usa dados reais do
// release (versão, download), nada inventado.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Carcará Code',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS 11 or later (Apple Silicon), Linux',
  softwareVersion: release.version,
  downloadUrl: [release.downloadUrl, release.macDownloadUrl].filter(Boolean),
  url: canonicalURL.href,
  description: pageDesc,
  keywords: s.meta.keywords,
  image: ogImageURL.href,
  inLanguage: loc.htmlLang,
  license: 'https://opensource.org/licenses/MIT',
  author: {
    '@type': 'Person',
    name: 'Ygor Andrade',
    url: 'https://ygorandrade.work',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency,
  },
};
---

<!DOCTYPE html>
<html lang={loc.htmlLang} dir={loc.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline set:html={themeScript} />

    <!-- Detecção de idioma (roda antes da pintura). Atua nas home localizadas:
         respeita a preferência salva; sem preferência, manda o navegador não-pt
         da raiz (/) para a home do idioma detectado. Não mexe com robôs. -->
    <script is:inline set:html={detectionScript} />

    <meta name="description" content={pageDesc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternates de idioma para o Google (evita conteúdo duplicado, entrega a
         versão certa por região/idioma). Uma entrada por idioma + x-default. -->
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta name="theme-color" content="#ede7dd" data-theme-color />
    <meta name="author" content="Ygor Andrade" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, Discord…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Carcará Code" />
    <meta property="og:locale" content={loc.ogLocale} />
    {others.map((l) => <meta property="og:locale:alternate" content={LOCALES[l].ogLocale} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={s.meta.ogAlt} />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data (schema.org SoftwareApplication) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script
      src="https://analytics.ygorandrade.work/api/script.js"
      data-site-id="aba3d3cca299"
      defer></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <!-- Persiste a escolha do seletor de idioma (para a detecção não desfazer a
         troca manual). -->
    <script>
      document.querySelectorAll('.cc-lang-switch').forEach((el) => {
        el.addEventListener('click', () => {
          try {
            localStorage.setItem('cc-lang', el.getAttribute('data-lang-switch') || 'pt');
          } catch (e) {}
        });
      });
    </script>
  </body>
</html>

<style is:global>
