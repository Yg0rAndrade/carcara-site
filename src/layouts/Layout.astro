  html[data-theme='light'] [style*='background:#D7A516'][style*='color:#fff'],
  html[data-theme='light'] [style*='background:#d7a516'][style*='color:#fff'] {
    color: #211c15 !important;
  }

  /* Tema escuro da landing. As regras ficam globais porque os componentes Astro
     são escopados e vários mocks usam estilos inline. */
  html[data-theme='dark'] .cc-nav {
    background: rgba(23, 19, 15, 0.88) !important;
    border-color: var(--cc-border) !important;
  }
  html[data-theme='dark'] .cc-nav > div > a:not([href='#download']),
