    background: #963807 !important;
  }
  html[data-theme='light'] [style*='background:#D2645E'][style*='color:#fff'],
  html[data-theme='light'] [style*='background:#d2645e'][style*='color:#fff'] {
    color: #ffffff !important;
    background: #923d39 !important;
  }
  html[data-theme='light'] [style*='background:#D99748'][style*='color:#fff'],
