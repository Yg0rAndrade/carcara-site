---
import { release } from '../data/release';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Carcará Code — Multiplexador de projetos e IDE para o Claude Code',
  description = 'Carcará Code é a IDE e o multiplexador de projetos para o Claude Code: vários ao mesmo tempo, cada um com chat e preview lado a lado. Grátis, open source e para Windows.',
} = Astro.props;

// URLs absolutas para canonical e Open Graph (dependem do `site` no astro.config).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);

// Structured data (schema.org) — ajuda o Google e as buscas por IA a entenderem
// que isto é um app grátis, de código aberto, pra Windows. Usa dados reais do
// release (versão, download) — nada inventado.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Carcará Code',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows 10, Windows 11',
  softwareVersion: release.version,
  downloadUrl: release.downloadUrl,
  url: canonicalURL.href,
  description,
  keywords:
    'multiplexador de projetos, multiplexador para Windows, IDE para Claude Code, gerenciar vários projetos, Claude Code, grátis, open source, Windows',
  image: ogImageURL.href,
  inLanguage: 'pt-BR',
  license: 'https://opensource.org/licenses/MIT',
  author: {
    '@type': 'Person',
    name: 'Ygor Andrade',
    url: 'https://ygorandrade.work',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'BRL',
  },
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#ede7dd" />
    <meta name="author" content="Ygor Andrade" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, Discord…) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Carcará Code" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content="Carcará Code: chat com o Claude Code à esquerda e preview do projeto rodando à direita" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data (schema.org SoftwareApplication) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script
      src="https://analytics.ygorandrade.work/api/script.js"
      data-site-id="aba3d3cca299"
      defer></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background-color: #ede7dd;
    background-image: linear-gradient(rgba(74, 58, 32, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(74, 58, 32, 0.055) 1px, transparent 1px);
    background-size: 32px 32px;
    color: #211c15;
    font-family: 'Hanken Grotesk', sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  ::selection {
    background: rgba(217, 151, 72, 0.32);
  }
  a {
    color: inherit;
  }
  @keyframes ccbob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-12px) rotate(2deg);
    }
  }
  @keyframes ccblink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  @keyframes ccfly {
    0% {
      transform: translateX(-10vw) translateY(0);
    }
    50% {
      transform: translateX(48vw) translateY(-16px);
    }
    100% {
      transform: translateX(110vw) translateY(4px);
    }
  }

  /* Flutuação suave + pulso do indicador "ao vivo" — usados só no mock da IDE
     (a janela do app), não afetam o tema do site. */
  @keyframes ccfloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }
  @keyframes ccpulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.82);
    }
  }

  /* ===== Revelação no scroll =====
     Elementos com .cc-reveal entram com fade + leve subida quando aparecem na
     viewport (o RevealScript adiciona .cc-in). Sem JS, ou com movimento
     reduzido, o conteúdo fica visível normalmente. */
  .cc-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.7s cubic-bezier(0.16, 0.84, 0.44, 1),
      transform 0.7s cubic-bezier(0.16, 0.84, 0.44, 1);
    will-change: opacity, transform;
  }
  .cc-reveal.cc-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cc-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    /* também desliga a flutuação da janela da IDE */
    [style*='ccfloat'] {
      animation: none !important;
    }
  }

  /* ===== Responsivo =====
     Os componentes usam estilo inline (especificidade máxima), então os
     overrides abaixo precisam de !important para vencer. As classes vivem nos
     contêineres que mudam de layout: Nav, Hero e o mock da IDE. */

  /* Tablet e abaixo: empilha o que era multicoluna. */
  @media (max-width: 860px) {
    .cc-hero-grid {
      grid-template-columns: 1fr !important;
    }
    .cc-ide-grid {
      grid-template-columns: 1fr !important;
      min-height: auto !important;
    }
    /* o rail vira uma faixa horizontal de ícones no topo da janela */
    .cc-ide-rail {
      flex-direction: row !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      gap: 10px !important;
      padding: 14px !important;
      border-right: none !important;
      border-bottom: 1px solid #eae3d5 !important;
    }
    /* divisórias passam a ser embaixo, já que as colunas agora empilham */
    .cc-ide-chat {
      border-right: none !important;
      border-bottom: 1px solid #eae3d5 !important;
    }
  }

  /* Celular: esconde os links de texto da nav, deixando logo + Baixar. */
  @media (max-width: 560px) {
    .cc-nav-link {
      display: none !important;
    }
  }
</style>
