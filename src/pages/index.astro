---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IdeMock from '../components/IdeMock.astro';
import Essencial from '../components/Essencial.astro';
import Features from '../components/Features.astro';
import Philosophy from '../components/Philosophy.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import ProjectRailScript from '../components/ProjectRailScript.astro';
import RefreshReleaseScript from '../components/RefreshReleaseScript.astro';
---

<Layout>
  <Nav />
  <Hero />
  <IdeMock />
  <Essencial />
  <Features />
  <Philosophy />
  <Download />
  <Footer />

  <!-- anima o rail de projetos (Hero + mock da IDE) -->
  <ProjectRailScript />
  <!-- atualiza link/versão de download com a última release do GitHub -->
  <RefreshReleaseScript />
</Layout>
