---
// ============================================================================
// Landing principal — repaginação estrutural (antiga /v2, agora index).
// Mantém o tema creme + brasa; o que muda é a ESTRUTURA: faixas de fundo
// alternadas (creme claro → escuro → âmbar), ritmo/hierarquia consistentes e
// blocos que faltavam (tabela comparativa, CTA forte recorrente). Referência de
// estrutura: Automarticles.
// ============================================================================
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IdeWindow from '../components/IdeWindow.astro';
import Demo from '../components/Demo.astro';
import Faq from '../components/Faq.astro';
import CarcaraLogo from '../components/CarcaraLogo.astro';
import ProjectRailScript from '../components/ProjectRailScript.astro';
import { Image } from 'astro:assets';
import { release } from '../data/release';
import { stars, STAR_MIN, formatStars, REPO_URL } from '../data/repo';
import { projects, letterOf } from '../data/projects';

import aiPerProject from '../assets/shots/ai-per-project.png';
import codeShot from '../assets/shots/code.png';
import previewSite from '../assets/shots/preview-site.png';
import previewLogin from '../assets/shots/preview-login.png';

const showStars = stars != null && stars >= STAR_MIN;

// Ícones de traço (stroke = currentColor), mesmo estilo do resto do site.
const ICON: Record<string, string> = {
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.4"/><rect x="14" y="3" width="7" height="7" rx="1.4"/><rect x="3" y="14" width="7" height="7" rx="1.4"/><rect x="14" y="14" width="7" height="7" rx="1.4"/>',
  chat: '<path d="M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/>',
  layers: '<path d="M12 3 3 8l9 5 9-5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  rewind: '<path d="M11 19 2 12l9-7v14z"/><path d="M22 19l-9-7 9-7v14z"/>',
  wand: '<path d="M13 3l2.3 6.2L21 12l-5.7 2.8L13 21l-2.3-6.2L5 12l5.7-2.8z"/><path d="M5 3v3M4 4.5h2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  x: '<path d="M18 6 6 18M6 6l12 12"/>',
  star: '<path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9z"/>',
};

// Grade de recursos (o "o que você ganha").
const features = [
  { icon: 'grid', title: 'Um bando de projetos', body: 'Cada subpasta da sua pasta raiz vira um ícone no rail. Bateu o olho, achou — sem abrir cinco janelas.' },
  { icon: 'chat', title: 'A IA na pasta certa', body: 'A conversa já aponta pro projeto aberto. Feito sob medida pro Claude Code, e aberto a outras IAs de código.' },
  { icon: 'globe', title: 'Seu site ao vivo', body: 'A IDE detecta seu dev server, sobe ele e mostra o site embutido enquanto você conversa.' },
  { icon: 'layers', title: 'Vários ao mesmo tempo', body: 'Cada projeto guarda sua conversa e seu preview. Pule de um pro outro sem perder o fio.' },
  { icon: 'rewind', title: 'Volte no tempo', body: 'Checkpoints num repositório-sombra: desfaça o que a IA fez num clique — sem sujar seu histórico do Git.' },
  { icon: 'wand', title: 'Sem terminal', body: 'Se você sabe descrever o que quer, o Carcará faz. Sem comando decorado — pra qualquer um.' },
];

// Screenshots reais, um recurso por slide.
const slides = [
  { img: aiPerProject, title: 'Cada projeto, a IA que você quiser', desc: 'Claude Code (o padrão), Codex, OpenCode, Antigravity ou um CLI seu — você escolhe por pasta.', alt: "Configurações do Carcará Code: 'IA por projeto', cada projeto podendo usar Claude Code, Codex, OpenCode, Antigravity ou um CLI personalizado" },
  { img: codeShot, title: 'Código e Git embutidos', desc: 'Veja os arquivos e o diff de cada mudança sem sair da IDE.', alt: 'Aba de código do Carcará Code: árvore de arquivos e um script com destaque de sintaxe' },
  { img: previewSite, title: 'Preview ao vivo', desc: 'A IDE sobe seu dev server e mostra o site embutido enquanto você conversa.', alt: 'Preview ao vivo no Carcará Code: a própria landing do Carcará rodando em localhost' },
  { img: previewLogin, title: 'Funciona em qualquer projeto', desc: 'De uma loja a uma tela de login: cada app mantém sua conversa e seu preview.', alt: 'Preview ao vivo de uma tela de login rodando dentro do Carcará Code' },
];

// Tabela comparativa: o jeito difícil vs. com o Carcará.
const compare = [
  ['Cinco janelas e abas pra achar um projeto', 'Um ícone por projeto no rail'],
  ['Terminal aberto e comandos decorados', 'Você conversa, ele cuida do código'],
  ['Chave de API e custo por token a cada mensagem', 'Usa a sua assinatura do Claude, sem API key'],
  ['Medo de deixar a IA mexer e bagunçar tudo', 'Checkpoints: volte no tempo num clique'],
  ['Perde o fio ao trocar de contexto', 'Cada projeto guarda conversa e preview'],
  ['Editor pesado, cheio de firula', 'Só o essencial: projetos, chat e preview'],
];

// Como começar (honesto: precisa de Node + Claude Code; já trata o SmartScreen).
const startSteps = [
  { n: '01', title: 'Node.js + Claude Code', body: 'Instale o Node.js e faça login no Claude Code uma vez. É o motor que o Carcará usa por baixo.' },
  { n: '02', title: 'Baixe e instale', body: 'Rode o instalador pra Windows. Na primeira vez o Windows pode dizer que "protegeu seu PC" — clique em Mais informações › Executar assim mesmo (o app ainda não é assinado).' },
  { n: '03', title: 'Aponte sua pasta', body: 'Abra o Carcará, escolha a pasta dos seus projetos e solte o bicho. Cada subpasta vira um ícone no rail.' },
];
---

<Layout>
  <Nav />

  <!-- ===================== HERO (faixa creme) ===================== -->
  <section class="v2band v2-hero">
    <div class="v2wrap v2-hero-grid">
      <div>
        <div class="v2-badge">
          <CarcaraLogo width={14} height={14} />
          IDE&nbsp;PARA&nbsp;O&nbsp;CLAUDE&nbsp;CODE
        </div>
        <h1 class="v2-hero-title">
          <span class="v2-hero-l1">Infinitos projetos,</span>
          <span class="v2-hero-l2">um único voo.</span>
        </h1>
        <p class="v2-hero-sub">
          Carcará Code é a IDE e o multiplexador de projetos para o Claude&nbsp;Code.
          Um ícone por projeto, com chat e preview lado a lado. Abra quantos quiser
          e voe entre eles num clique.
        </p>
        <div class="v2-hero-cta">
          <a href={release.downloadUrl} data-dl-link class="v2-btn v2-btn--amber">
            <CarcaraLogo width={19} height={19} fill="#211C15" />
            Baixar grátis para Windows
          </a>
          <a href="#ide" class="v2-btn v2-btn--ghost">Ver a IDE</a>
        </div>
        <span class="v2-hero-meta">
          .exe &nbsp;·&nbsp; <span data-dl-version>{release.tag}</span> &nbsp;·&nbsp; grátis &nbsp;·&nbsp; open source
        </span>
      </div>

      <div class="v2-hero-visual">
        <div class="v2-mock-scaler"><IdeWindow /></div>
      </div>
    </div>
  </section>

  <!-- ===================== TRUST (faixa escura) ===================== -->
  <section class="v2band v2band--dark v2-trust">
    <div class="v2wrap v2-trust-row">
      <div class="v2-trust-item">
        <span class="v2-trust-big">100% grátis</span>
        <span class="v2-trust-sub">código aberto · MIT</span>
      </div>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <div class="v2-trust-item">
        <span class="v2-trust-big">Sua assinatura</span>
        <span class="v2-trust-sub">sem API key · sem custo por token</span>
      </div>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <a href={REPO_URL} target="_blank" rel="noopener" class="v2-trust-item v2-trust-link">
        <span class="v2-trust-big">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#E7B368; vertical-align:-2px;"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9z"/></svg>
          <span data-gh-stars>{showStars ? formatStars(stars as number) : 'GitHub'}</span>
        </span>
        <span class="v2-trust-sub">estrelar no GitHub</span>
      </a>
      <span class="v2-trust-div" aria-hidden="true"></span>
      <div class="v2-trust-item">
        <span class="v2-trust-big">Windows 10/11</span>
        <span class="v2-trust-sub">macOS · Linux via código</span>
      </div>
    </div>
  </section>

  <!-- ===================== MUITOS PROJETOS / carrossel lado a lado (faixa papel) ===================== -->
  <section class="v2band v2band--paper" id="ide">
    <span id="recursos" aria-hidden="true" style="display:block; height:0;"></span>
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker">A&nbsp;IDE</div>
        <h2>Muitos projetos, <span class="v2-em">zero firula</span>.</h2>
        <p>Um recurso por vez — passe pro lado e veja o Carcará por dentro.</p>
      </div>

      <div class="cc-carousel">
        <div class="cc-track" data-track>
          {slides.map((s, i) => (
            <figure class="cc-slide">
              <div class="cc-slide-inner">
                <div class="cc-slide-frame">
                  <Image class="cc-shot-img" src={s.img} alt={s.alt} widths={[480, 640, 960]} sizes="(max-width:820px) 92vw, 540px" quality={82} loading="eager" />
                </div>
                <figcaption class="cc-slide-cap">
                  <span class="cc-slide-num">{String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}</span>
                  <h3>{s.title}</h3>
                  <p>{s.desc}</p>
                </figcaption>
              </div>
            </figure>
          ))}
        </div>

        <button type="button" class="cc-car-arrow cc-car-prev" data-prev aria-label="Recurso anterior">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <button type="button" class="cc-car-arrow cc-car-next" data-next aria-label="Próximo recurso">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </button>

        <div class="cc-car-dots" data-dots>
          {slides.map((_, i) => (
            <button type="button" class="cc-dot" data-dot={i} aria-label={`Ir para o recurso ${i + 1}`} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== VÍDEO ===================== -->
  <Demo />

  <!-- ===================== ASSINATURA (faixa âmbar) ===================== -->
  <section class="v2band v2band--amber">
    <div class="v2wrap v2sh">
      <div class="v2-kicker">SEM&nbsp;API&nbsp;KEY</div>
      <h2>Usa a <span class="v2-em">sua assinatura</span> do Claude.</h2>
      <p>
        Já paga o Claude? Então já pode usar o Carcará. Ele conversa direto com a sua
        assinatura — <strong>sem chave de API e sem custo por token</strong> a cada
        mensagem. O que você já tem, funcionando na sua IDE.
      </p>
    </div>
  </section>

  <!-- ===================== COMPARATIVO (faixa escura) ===================== -->
  <section class="v2band v2band--dark">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker">O&nbsp;SALTO</div>
        <h2>Antes e <span class="v2-em">depois</span>.</h2>
        <p>O mesmo trabalho, sem o atrito de sempre.</p>
      </div>
      <div class="v2-cmp">
        <div class="v2-cmp-col v2-cmp-before">
          <div class="v2-cmp-head">Do jeito difícil</div>
          {compare.map(([before]) => (
            <div class="v2-cmp-row">
              <span class="v2-cmp-mark v2-cmp-mark--x">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.x} />
              </span>
              <span>{before}</span>
            </div>
          ))}
        </div>
        <div class="v2-cmp-col v2-cmp-after">
          <div class="v2-cmp-head">Com o Carcará</div>
          {compare.map(([, after]) => (
            <div class="v2-cmp-row">
              <span class="v2-cmp-mark v2-cmp-mark--check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.check} />
              </span>
              <span>{after}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FILOSOFIA (faixa creme) ===================== -->
  <section class="v2band">
    <div class="v2wrap v2-quote">
      <CarcaraLogo width={44} height={44} />
      <p class="v2-quote-big">Pega o projeto, <span class="v2-em">resolve e entrega</span>.</p>
      <p class="v2-quote-sub">
        O carcará é rápido, esperto e destemido. Não depende de uma presa só e nunca
        fica na mão. Sua IDE devia ser do mesmo jeito: leve, valente, e com todos os
        seus projetos a um clique de distância.
      </p>
    </div>
  </section>

  <!-- ===================== COMO COMEÇAR (faixa papel) ===================== -->
  <section class="v2band v2band--paper">
    <div class="v2wrap">
      <div class="v2sh">
        <div class="v2-kicker">COMO&nbsp;COMEÇAR</div>
        <h2>Do zero ao <span class="v2-em">primeiro projeto</span>.</h2>
        <p>Grátis e de código aberto. Em três passos, honestos.</p>
      </div>
      <div class="v2-steps">
        {startSteps.map((s) => (
          <div class="v2-step">
            <div class="v2-step-n">{s.n}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <Faq />

  <!-- ===================== DOWNLOAD / CTA final (faixa âmbar) ===================== -->
  <section class="v2band v2band--amber" id="download">
    <div class="v2wrap v2sh">
      <div class="v2-kicker">DOWNLOAD</div>
      <h2>Solte o <span class="v2-em">carcará</span>.</h2>
      <p>Gratuito, de código aberto e pra Windows. Traga seus projetos e voe.</p>
      <div class="v2-dl">
        <a href={release.downloadUrl} data-dl-link class="v2-btn v2-btn--dark">
          <CarcaraLogo width={22} height={22} fill="#F3EDE1" />
          Baixar grátis para Windows
        </a>
        <div class="v2-dl-meta">
          <span data-dl-filename>{release.fileName}</span> · <span data-dl-meta>{release.tag} · {release.size} · {release.date}</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- anima o rail do mock: cicla projeto ativo + troca chat/preview com crossfade -->
  <ProjectRailScript />
</Layout>

<style>
  /* ===== Sistema de faixas ===== */
  .v2band {
    width: 100%;
  }
  .v2band--paper {
    background: #fbf8f1;
    border-top: 1px solid #ece4d5;
    border-bottom: 1px solid #ece4d5;
  }
  .v2band--dark {
    background: #1e1913;
    color: #ede7dd;
  }
  .v2band--amber {
    background: linear-gradient(160deg, #f4d9a8 0%, #e9b268 55%, #dd9a3f 100%);
  }
  .v2wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(56px, 7vw, 100px) clamp(20px, 5vw, 56px);
  }

  /* ===== Cabeçalho de seção ===== */
  .v2sh {
    text-align: center;
    max-width: 46em;
    margin-left: auto;
    margin-right: auto;
  }
  .v2sh > .v2-grid,
  .v2sh > .v2-cmp,
  .v2sh > .v2-steps {
    text-align: left;
  }
  .v2-kicker {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.06em;
    color: #b07d2f;
    margin-bottom: 16px;
  }
  .v2band--dark .v2-kicker {
    color: #e7b368;
  }
  .v2band--amber .v2-kicker {
    color: #5e3f12;
  }
  .v2sh h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(30px, 4.4vw, 54px);
    line-height: 1.04;
    margin: 0 0 14px;
    color: #211c15;
  }
  .v2band--dark .v2sh h2 {
    color: #f3ede1;
  }
  .v2band--amber .v2sh h2 {
    color: #2a2410;
  }
  .v2-em {
    font-style: italic;
    color: #c5821c;
  }
  .v2band--dark .v2-em {
    color: #e7b368;
  }
  .v2band--amber .v2-em {
    color: #6b3f0a;
  }
  .v2sh p {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    color: #5c5347;
    margin: 0 auto;
  }
  .v2band--dark .v2sh p {
    color: #c3b8a5;
  }
  .v2band--amber .v2sh p {
    color: #4a3a1a;
  }
  .v2band--amber .v2sh strong {
    color: #2a2410;
    font-weight: 800;
  }

  /* ===== Botões ===== */
  .v2-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 16.5px;
    text-decoration: none;
    padding: 15px 26px;
    border-radius: 12px;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .v2-btn--amber {
    color: #211c15;
    background: #d99748;
    box-shadow: 0 4px 0 #a06f2e, 0 10px 24px rgba(160, 111, 46, 0.3);
  }
  .v2-btn--amber:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #a06f2e, 0 14px 30px rgba(160, 111, 46, 0.34);
  }
  .v2-btn--ghost {
    color: #3a342b;
    background: transparent;
    border: 1px solid #d8cfbe;
  }
  .v2-btn--ghost:hover {
    border-color: #c5821c;
  }
  .v2-btn--dark {
    color: #f3ede1;
    background: #211c15;
    box-shadow: 0 6px 18px rgba(33, 28, 21, 0.35);
  }
  .v2-btn--dark:hover {
    transform: translateY(-2px);
  }

  /* ===== Hero ===== */
  .v2-hero .v2wrap {
    padding-top: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .v2-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .v2-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'Press Start 2P', monospace;
    font-size: 9.5px;
    color: #b07d2f;
    letter-spacing: 0.05em;
    margin-bottom: 26px;
    background: #fbf8f1;
    border: 1px solid #e7e0d2;
    padding: 8px 12px;
    border-radius: 999px;
  }
  .v2-hero-title {
    margin: 0 0 22px;
  }
  .v2-hero-l1 {
    display: block;
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(40px, 5.4vw, 70px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: #211c15;
  }
  .v2-hero-l2 {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(44px, 6vw, 78px);
    line-height: 1;
    color: #c5821c;
  }
  .v2-hero-sub {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: #5c5347;
    max-width: 30em;
    margin: 0 0 32px;
  }
  .v2-hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 13px;
  }
  .v2-hero-meta {
    display: block;
    margin-top: 15px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #8a8073;
    letter-spacing: 0.02em;
  }
  /* Frame 16/9: o mock é renderizado numa largura fixa "de design" (850px, onde
     já nasce confortável e ~16/9) e ESCALADO por JS pra caber no frame. Assim os
     elementos encolhem TODOS juntos — em vez de ficarem grandes num quadro
     apertado. */
  .v2-hero-visual {
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 28px 60px -20px rgba(110, 80, 30, 0.45),
      0 10px 22px -12px rgba(110, 80, 30, 0.22);
  }
  .v2-mock-scaler {
    width: 850px;
    transform-origin: top left;
    will-change: transform;
  }
  .v2-mock-scaler > :global(div) {
    box-shadow: none;
    border-radius: 16px;
  }

  /* ===== Trust strip ===== */
  .v2-trust .v2wrap {
    padding-top: clamp(26px, 3vw, 38px);
    padding-bottom: clamp(26px, 3vw, 38px);
  }
  .v2-trust-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 40px);
    text-align: center;
  }
  .v2-trust-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
  }
  .v2-trust-big {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(18px, 2vw, 23px);
    color: #f3ede1;
  }
