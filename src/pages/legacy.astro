---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import IdeMock from '../components/IdeMock.astro';
import Demo from '../components/Demo.astro';
import Essencial from '../components/Essencial.astro';
import Features from '../components/Features.astro';
import Philosophy from '../components/Philosophy.astro';
import Faq from '../components/Faq.astro';
import Assinatura from '../components/Assinatura.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import RefreshReleaseScript from '../components/RefreshReleaseScript.astro';
import RefreshStarsScript from '../components/RefreshStarsScript.astro';
import RevealScript from '../components/RevealScript.astro';
---

<Layout noindex={true}>
  <Nav />
  <Hero />
  <SocialProof />

  <!-- seções abaixo da dobra entram com fade ao rolar (.cc-reveal) -->
  <div class="cc-reveal"><IdeMock /></div>
  <div class="cc-reveal"><Demo /></div>
  <div class="cc-reveal"><Essencial /></div>
  <div class="cc-reveal"><Features /></div>
  <div class="cc-reveal"><Philosophy /></div>
  <div class="cc-reveal"><Faq /></div>
  <div class="cc-reveal"><Assinatura /></div>
  <div class="cc-reveal"><Download /></div>
  <Footer />

  <!-- revela as seções .cc-reveal quando entram na viewport -->
  <RevealScript />
  <!-- atualiza link/versão de download com a última release do GitHub -->
  <RefreshReleaseScript />
  <!-- atualiza a contagem de estrelas do GitHub -->
  <RefreshStarsScript />
</Layout>
